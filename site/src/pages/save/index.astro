---
// site/src/pages/save/index.astro
//
// issue #69: 保存(☆)タブのページ。localStorage(lib/save-store.ts) に
// 保存された問題 ID を、既存の検索インデックス（/search-index.json、#61）と
// 突き合わせて一覧表示する。新しいデータソースは増やさない。
//
// localStorage が使えない環境では一覧は「保存機能が使えません」という
// 案内のみを表示する（他ページ・他機能に影響しない。site/CLAUDE.md 禁止事項
// 「localStorage 等への依存を前提とした必須機能の実装」を避けるため、
// この機能自体が任意のブックマークという位置づけ）。
import BottomTabNav from "../../components/BottomTabNav.astro";
import SearchModal from "../../components/SearchModal.astro";
import SiteHead from "../../components/SiteHead.astro";
---

<html lang="ja">
	<head>
		<SiteHead
			title="保存した問題 — Diary"
			description="保存した問題の一覧です（この端末のブラウザにのみ保存されます）。"
		/>
		<style>
			:root {
				color-scheme: dark;
			}
			* {
				box-sizing: border-box;
			}
			html,
			body {
				margin: 0;
				background: #05060a;
				color: #eef2f6;
				font-family: "Noto Sans JP", system-ui, sans-serif;
			}
			a {
				color: inherit;
				text-decoration: none;
			}
			.page {
				max-width: 900px;
				margin: 0 auto;
				padding-bottom: 80px;
			}
			.site-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 22px 48px;
				border-bottom: 1px solid rgba(255, 255, 255, 0.07);
			}
			.brand {
				display: flex;
				align-items: baseline;
				gap: 12px;
			}
			.brand strong {
				font: 700 19px "Space Grotesk", sans-serif;
			}
			.brand span {
				font: 400 10px "IBM Plex Mono", monospace;
				color: #768190;
				letter-spacing: 0.18em;
			}
			.site-nav {
				display: flex;
				align-items: center;
				gap: 30px;
				font-size: 13px;
				color: #aeb6c2;
			}
			.site-nav .search-chip {
				display: flex;
				align-items: center;
				gap: 8px;
				padding: 7px 14px;
				border: 1px solid rgba(255, 255, 255, 0.14);
				border-radius: 999px;
				font: 400 11px "IBM Plex Mono", monospace;
				color: #7d8794;
				cursor: pointer;
			}
			.hero {
				padding: 56px 48px 28px;
			}
			.hero .label {
				font: 500 11px "IBM Plex Mono", monospace;
				letter-spacing: 0.3em;
				color: #52e0f5;
			}
			.hero h1 {
				margin: 12px 0 0;
				font-size: 44px;
				font-weight: 900;
				line-height: 1.2;
			}
			.hero p {
				margin: 14px 0 0;
				font-size: 14px;
				line-height: 1.9;
				color: #7d8794;
				max-width: 560px;
			}
			.hero p a {
				color: #52e0f5;
				text-decoration: underline;
			}
			.save-list {
				padding: 0 48px;
				display: flex;
				flex-direction: column;
			}
			.empty-state,
			.unavailable-state {
				padding: 40px 48px 0;
				color: #7d8794;
				font-size: 14px;
				line-height: 1.9;
			}
			@media (max-width: 720px) {
				.site-header {
					padding: 16px 24px;
				}
				.hero {
					padding: 40px 24px 20px;
				}
				.hero h1 {
					font-size: 28px;
				}
				.save-list,
				.empty-state,
				.unavailable-state {
					padding-left: 24px;
					padding-right: 24px;
				}
				.page {
					padding-bottom: 96px;
				}
			}
		</style>
		<style is:global>
			/*
			 * #250: .save-row とその子孫は一覧描画スクリプト（下部の <script>）が
			 * document.createElement で実行時に生成するため、Astro のスコープ付き
			 * CSS（data-astro-cid-*）が当たらない。生成された要素にはその属性が
			 * 付かないため、通常の <style> に書くとルールが 1 つも効かない。
			 * ここだけ is:global にして、.save-list（テンプレートに存在する）配下に
			 * 限定したセレクタで動的行にもスタイルを適用する。
			 */
			.save-list .save-row {
				display: flex;
				align-items: center;
				gap: 20px;
				padding: 20px 0;
				border-top: 1px solid rgba(255, 255, 255, 0.09);
			}
			.save-list a.save-row:last-child {
				border-bottom: 1px solid rgba(255, 255, 255, 0.09);
			}
			.save-list .save-row:hover {
				background: rgba(82, 224, 245, 0.04);
			}
			.save-list .save-row .id {
				font: 500 13px "IBM Plex Mono", monospace;
				color: #52e0f5;
				flex-shrink: 0;
			}
			.save-list .save-row .title {
				flex: 1;
				font-size: 16px;
				font-weight: 500;
			}
			.save-list .save-row .meta {
				font: 400 11px "IBM Plex Mono", monospace;
				color: #7d8794;
				flex-shrink: 0;
			}
			/*
			 * #131: 難易度バッジも .save-row と同じ理由（実行時生成、#250 参照）で
			 * is:global + .save-list 配下限定のセレクタが必要。クラス名・構造は
			 * DifficultyBadge.astro（Astro テンプレートで描画するページ用）と揃えて
			 * ある（.difficulty-badge > .dots + .num）。値は
			 * site/src/lib/difficulty.ts の createDifficultyBadgeElement() が
			 * 唯一の参照元で、この CSS は見た目だけを合わせている。
			 */
			.save-list .save-row .difficulty-badge {
				display: inline-flex;
				align-items: center;
				gap: 8px;
				flex-shrink: 0;
			}
			.save-list .save-row .difficulty-badge .dots {
				display: flex;
				gap: 3px;
			}
			.save-list .save-row .difficulty-badge .dots span {
				width: 5px;
				height: 5px;
				border-radius: 50%;
				background: #2a3340;
			}
			.save-list .save-row .difficulty-badge .dots span.on {
				background: #52e0f5;
			}
			.save-list .save-row .difficulty-badge .num {
				font: 400 11px "IBM Plex Mono", monospace;
				color: #7d8794;
				letter-spacing: 0.04em;
			}
		</style>
	</head>
	<body>
		<div class="page">
			<header class="site-header">
				<a class="brand" href="/">
					<strong>Diary</strong>
					<span>SELF-MADE MATHEMATICS</span>
				</a>
				<nav class="site-nav">
					<a href="/fields/">分野</a>
					<a href="/archive/">アーカイブ</a>
					<a href="/about/">About</a>
					<span class="search-chip" data-search-open>検索⌘K</span>
				</nav>
			</header>

			<SearchModal />

			<main>
			<section class="hero">
				<span class="label">SAVED</span>
				<h1>保存した問題</h1>
				<p>
					この端末のブラウザ内(localStorage)にのみ保存されます。他の端末とは共有されません。
					難易度バッジの基準は<a href="/about/#difficulty">こちら</a>。
				</p>
			</section>

			<div id="save-list" class="save-list"></div>
			<p id="save-empty" class="empty-state" hidden>まだ保存した問題がありません。問題ページの ☆ ボタンから保存できます。</p>
			<!--
				#save-load-error と #save-unavailable の役割分担（issue #253）:
				- #save-unavailable: localStorage 自体が使えない環境（設定で無効化・
				  一部ブラウザの制限等）。isStorageAvailable() が false を返す時点で
				  確定し、以降の処理は行わない。
				- #save-load-error: localStorage 自体は使え、保存 ID も取得できたが
				  （＝保存されているはず）、一覧の組み立てに失敗した場合。保存データの
				  破損・容量超過・プライベートブラウジングでの挙動など、ブラウザ側の
				  一時的な問題が原因になりうる（通信の問題ではない。保存は localStorage
				  のみを使い、ネットワーク通信を伴わないため）。
				どちらも hidden で初期化し、render() 内で条件に応じて片方だけを
				表示する（同時に出ることはない）。
			-->
			<p id="save-load-error" class="empty-state" hidden>
				保存した問題の読み込みに失敗しました。保存データの破損や、ブラウザの制限（プライベートブラウジングモードでの動作や保存容量の超過など）が原因である可能性があります。再読み込みすると解決する場合があります。
			</p>
			<p id="save-unavailable" class="unavailable-state" hidden>
				この端末・ブラウザでは保存機能を利用できません（localStorage が無効になっています）。
			</p>
			</main>
		</div>

		<BottomTabNav active="save" />

		<script>
			import { isStorageAvailable, listSaved } from "../../lib/save-store";
			import { createDifficultyBadgeElement } from "../../lib/difficulty";

			async function render() {
				const listEl = document.getElementById("save-list");
				const emptyEl = document.getElementById("save-empty");
				const loadErrorEl = document.getElementById("save-load-error");
				const unavailableEl = document.getElementById("save-unavailable");
				if (!listEl || !emptyEl || !loadErrorEl || !unavailableEl) return;

				if (!isStorageAvailable()) {
					unavailableEl.hidden = false;
					return;
				}

				const ids = listSaved();
				if (ids.length === 0) {
					emptyEl.hidden = false;
					return;
				}

				try {
					const res = await fetch("/search-index.json");
					if (!res.ok) throw new Error(String(res.status));
					const index: { id: string; title: string; field: string; sub: string; difficulty: string }[] =
						await res.json();
					const byId = new Map(index.map((e) => [e.id, e]));
					const entries = ids.map((id) => byId.get(id)).filter((e): e is NonNullable<typeof e> => Boolean(e));
					if (entries.length === 0) {
						emptyEl.hidden = false;
						return;
					}
					for (const entry of entries) {
						const row = document.createElement("a");
						row.className = "save-row";
						row.href = `/problems/${entry.id}/`;
						const no = document.createElement("span");
						no.className = "id";
						no.textContent = entry.id;
						const title = document.createElement("span");
						title.className = "title";
						title.textContent = entry.title;
						const meta = document.createElement("span");
						meta.className = "meta";
						meta.textContent = [entry.field, entry.sub].filter(Boolean).join(" / ");
						const badge = createDifficultyBadgeElement(entry.difficulty);
						row.append(no, title, meta, badge);
						listEl.appendChild(row);
					}
				} catch {
					// 保存 ID 自体は取得できているため「保存した問題はありません」
					// (emptyEl) ではなく、読み込みに失敗したことが分かる専用の
					// メッセージ(loadErrorEl)を出す。途中まで行が追加されている
					// 場合に備え、表示は一覧をクリアしてから切り替える。
					listEl.innerHTML = "";
					loadErrorEl.hidden = false;
				}
			}

			render();
		</script>
	</body>
</html>
