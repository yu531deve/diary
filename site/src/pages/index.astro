---
// トップページ（仮）。#61 でビルド時データ生成ユーティリティ（site-data.ts）
// 経由に置き換え。content/ 配下の status: published な問題一覧に加え、
// 公開問題数・分野数・分野別問題数・新着一覧を実データから算出して表示する。
// パーティクル演出等の High-fidelity 実装は別 issue（design/01_top_scroll 系）で行う。
import { listPublishedProblems } from "../lib/dist-content";
import { computeSiteStats } from "../lib/site-data";
import LoadingCurtain from "../components/LoadingCurtain.astro";

const problems = listPublishedProblems();
const stats = computeSiteStats();
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>Diary — 自作入試数学問題集</title>
		<style>
			:root {
				color-scheme: light dark;
				font-family: system-ui, sans-serif;
			}
			body {
				max-width: 40rem;
				margin: 0 auto;
				padding: 1.5rem;
				line-height: 1.6;
			}
			h1 {
				font-size: 1.5rem;
			}
			ul {
				padding-left: 1.2rem;
			}
			a {
				color: inherit;
			}
			.stats {
				display: flex;
				gap: 1.5rem;
				font-variant-numeric: tabular-nums;
			}
		</style>
	</head>
	<body>
		<LoadingCurtain />
		<nav>
			<a href="/fields/">分野から探す</a>
		</nav>
		<h1>Diary — 自作入試数学問題集</h1>
		<p>自作の大学入試数学問題を公開しています。</p>
		<p class="stats">
			<span>PROBLEMS {stats.problemCount}</span>
			<span>FIELDS {stats.fieldCount}</span>
		</p>
		<h2>分野別</h2>
		<ul>
			{
				stats.byField.map((f) => (
					<li>
						{f.major}（{f.count}）
					</li>
				))
			}
		</ul>
		<h2>新着</h2>
		<ul>
			{
				stats.recent.map((p) => (
					<li>
						<a href={`/problems/${p.id}/`}>{p.title}</a>
					</li>
				))
			}
		</ul>
		<h2>全問題</h2>
		<ul>
			{
				problems.map((p) => (
					<li>
						<a href={`/problems/${p.id}/`}>{p.title}</a>
					</li>
				))
			}
		</ul>
	</body>
</html>
