---
// トップページ（#63 M1-D2: design/01_top_scroll.dc.html の High-fidelity 実装）。
//
// - スクロール駆動パーティクル演出は site/src/lib/particles/（#62）を使用。
//   このページでは新規に canvas 描画ロジックを書かない（不足があれば改修せず
//   README に不足を記録して回避策を取る運用。site/CLAUDE.md 例外規定参照）。
// - 統計・分野・新着は #61 の site-data.ts 経由で実データから生成する
//   （0042 / 18 のような数値のハードコード禁止。design/README.md 実装時の注意 6）。
// - prefers-reduced-motion: reduce では演出を停止し、Diary の静止形のみを表示する。
//   キャプション等のテキストは通常表示のまま（site/CLAUDE.md 必須条件）。
// - モバイル幅（<=860px）でも #track のスクロール駆動演出をそのまま使う
//   （#118, Yu 指示 2026-08-08。site/CLAUDE.md の例外条項を上書き）。
//   ただし発熱・fps を考慮し、パーティクル数と canvas の devicePixelRatio 上限を
//   モバイルで下げて軽量化する（詳細は script 内コメント参照）。
import { computeSiteStats } from "../lib/site-data";
import LoadingCurtain from "../components/LoadingCurtain.astro";
import SearchModal from "../components/SearchModal.astro";
import BottomTabNav from "../components/BottomTabNav.astro";
import { formatMathTitle } from "../lib/title";

const stats = computeSiteStats();

const fieldRows = stats.byField.map((f, i) => ({
	no: String(i + 1).padStart(2, "0"),
	major: f.major,
	count: f.count,
}));

const recent = stats.recent;

function difficultyDots(difficulty: string): boolean[] {
	const n = Math.max(0, Math.min(5, parseInt(difficulty, 10) || 0));
	return Array.from({ length: 5 }, (_, i) => i < n);
}

function formatDate(d: string): string {
	return d ? d.replaceAll("-", ".") : "";
}

const problemsPadded = String(stats.problemCount).padStart(4, "0");
const fieldsPadded = String(stats.fieldCount).padStart(2, "0");

const issueHref =
	"https://github.com/yu531deve/diary/issues/new?labels=typo&title=" +
	encodeURIComponent("[誤植報告] トップページ");
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="理工系大学院入試の自作数学問題を公開しています。解く価値のある一問を、1000問へ。"
		/>
		<title>Diary — 理工系院試数学 自作問題集</title>
		<link
			href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&family=IBM+Plex+Mono:wght@400;500&family=STIX+Two+Text:ital,wght@0,400;0,700;1,400;1,700&family=Space+Grotesk:wght@700&display=swap"
			rel="stylesheet"
		/>
		<style>
			:root {
				color-scheme: dark;
			}
			* {
				box-sizing: border-box;
			}
			body {
				margin: 0;
				background: #05060a;
				color: #eef2f6;
				font-family: "Noto Sans JP", sans-serif;
			}
			a {
				color: inherit;
				text-decoration: none;
			}
			a:hover {
				opacity: 0.8;
			}
			::selection {
				background: #52e0f5;
				color: #05060a;
			}

			@keyframes scrollpulse {
				0%,
				100% {
					transform: translateY(0);
					opacity: 0.9;
				}
				50% {
					transform: translateY(8px);
					opacity: 0.4;
				}
			}

			/* ---------- 固定ヘッダー ---------- */
			.site-nav {
				position: fixed;
				top: 0;
				left: 0;
				right: 0;
				z-index: 20;
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 26px 48px;
				background: linear-gradient(180deg, rgba(5, 6, 10, 0.85), rgba(5, 6, 10, 0));
			}
			.site-nav .brand {
				display: flex;
				align-items: baseline;
				gap: 12px;
			}
			.site-nav .brand strong {
				font: 700 19px "Space Grotesk", sans-serif;
			}
			.site-nav .brand span {
				font: 400 10px "IBM Plex Mono", monospace;
				color: #768190;
				letter-spacing: 0.18em;
			}
			.site-nav .links {
				display: flex;
				align-items: center;
				gap: 32px;
				font-size: 13px;
				color: #aeb6c2;
			}
			.site-nav .links a {
				white-space: nowrap;
			}
			.site-nav .kbd {
				display: flex;
				align-items: center;
				gap: 8px;
				padding: 7px 14px;
				border: 1px solid rgba(255, 255, 255, 0.14);
				border-radius: 999px;
				font: 400 11px "IBM Plex Mono", monospace;
				color: #7d8794;
			}
			.site-nav .kbd span {
				color: #6d7a8f;
			}

			/* ---------- カスタムカーソル ---------- */
			#cur {
				position: fixed;
				top: 0;
				left: 0;
				width: 34px;
				height: 34px;
				border: 1px solid rgba(82, 224, 245, 0.8);
				border-radius: 50%;
				pointer-events: none;
				z-index: 60;
				mix-blend-mode: screen;
			}
			#curdot {
				position: fixed;
				top: 0;
				left: 0;
				width: 6px;
				height: 6px;
				border-radius: 50%;
				background: #52e0f5;
				pointer-events: none;
				z-index: 60;
			}
			@media (hover: none), (pointer: coarse) {
				#cur,
				#curdot {
					display: none;
				}
			}

			/* ---------- スクロール演出トラック ---------- */
			#track {
				position: relative;
				height: 720vh;
				/* iOS Safari 等でアドレスバーの伸縮により 100vh がずれるため、
				   対応ブラウザでは svh を優先する（未対応時は上の vh 指定が残る）。 */
				height: 720svh;
			}
			#stage {
				position: sticky;
				top: 0;
				height: 100vh;
				height: 100svh;
				overflow: hidden;
			}
			#fx {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				display: block;
			}
			.caption {
				position: absolute;
				opacity: 0;
			}
			#c1 {
				left: 0;
				right: 0;
				top: 64vh;
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 18px;
				opacity: 1;
			}
			#c1 .eyebrow {
				font: 500 11px "IBM Plex Mono", monospace;
				letter-spacing: 0.34em;
				color: #52e0f5;
				text-align: center;
			}
			#c1 p {
				margin: 0;
				font-size: 18px;
				font-weight: 500;
				color: #c3ccd8;
				letter-spacing: 0.06em;
				text-align: center;
			}
			#c1 .scroll-hint {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 8px;
				margin-top: 14px;
				font: 400 10px "IBM Plex Mono", monospace;
				color: #768190;
				letter-spacing: 0.3em;
			}
			#c1 .scroll-hint i {
				display: block;
				width: 1px;
				height: 34px;
				background: linear-gradient(180deg, #52e0f5, transparent);
				animation: scrollpulse 2s ease-in-out infinite;
			}
			#c-gamma,
			#c-beta {
				left: 48px;
				top: 0;
				height: 100vh;
				height: 100svh;
				display: flex;
				flex-direction: column;
				justify-content: center;
				gap: 20px;
				max-width: 440px;
			}
			#c-gamma .eyebrow,
			#c-beta .eyebrow {
				font: 500 11px "IBM Plex Mono", monospace;
				letter-spacing: 0.24em;
				color: #52e0f5;
			}
			#c-gamma h2,
			#c-beta h2 {
				margin: 0;
				font-size: 40px;
				font-weight: 900;
				line-height: 1.35;
				text-wrap: pretty;
			}
			#c-gamma .formula,
			#c-beta .formula {
				font: italic 400 21px "STIX Two Text", serif;
				color: #aab6d4;
			}
			#c-gamma p,
			#c-beta p {
				margin: 0;
				font-size: 14px;
				line-height: 1.9;
				color: #7d8794;
			}
			#c3 {
				left: 0;
				right: 0;
				top: 66vh;
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 12px;
			}
			#c3 .eyebrow {
				font: 500 11px "IBM Plex Mono", monospace;
				letter-spacing: 0.3em;
				color: #52e0f5;
			}
			#c3 p {
				margin: 0;
				font-size: 19px;
				font-weight: 500;
				color: #c3ccd8;
			}
			#c4 {
				left: 0;
				right: 0;
				top: 0;
				height: 100vh;
				height: 100svh;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				gap: 26px;
				pointer-events: none;
			}
			#c4 h2 {
				margin: 0;
				font-size: 56px;
				font-weight: 900;
				letter-spacing: 0.02em;
				text-align: center;
				text-wrap: pretty;
			}
			#c4 .cta {
				display: flex;
				gap: 14px;
			}
			#c4 .cta a.primary {
				padding: 15px 32px;
				background: #52e0f5;
				color: #06232a;
				font-weight: 700;
				font-size: 14px;
				border-radius: 2px;
			}
			#c4 .cta a.secondary {
				padding: 15px 32px;
				border: 1px solid rgba(255, 255, 255, 0.25);
				color: #dfe6ee;
				font-size: 14px;
				border-radius: 2px;
			}

			.scene-indicator {
				position: absolute;
				right: 48px;
				top: 50%;
				transform: translateY(-50%);
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 14px;
			}
			.scene-indicator .num {
				font: 400 11px "IBM Plex Mono", monospace;
				color: #7d8794;
				letter-spacing: 0.2em;
			}
			.scene-indicator .bar {
				display: block;
				width: 1px;
				height: 120px;
				background: rgba(255, 255, 255, 0.12);
				position: relative;
				overflow: hidden;
			}
			.scene-indicator .bar i {
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				background: #52e0f5;
				transform: scaleY(0);
				transform-origin: top;
			}

			.stage-stats {
				position: absolute;
				left: 48px;
				bottom: 32px;
				display: flex;
				gap: 36px;
				font: 400 11px "IBM Plex Mono", monospace;
				color: #768190;
				letter-spacing: 0.12em;
			}
			.stage-stats strong {
				color: #dfe6ee;
				font-weight: 400;
			}
			.stage-stats .goal strong {
				color: #52e0f5;
			}


			/* ---------- スクロール後のセクション ---------- */
			.after-stage {
				position: relative;
				z-index: 1;
				background: #05060a;
			}
			.fields-section,
			.new-section {
				padding: 40px 48px 90px;
				max-width: 1400px;
				margin: 0 auto;
			}
			.fields-section {
				padding-top: 120px;
			}
			.section-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				margin-bottom: 34px;
			}
			.section-head h2 {
				margin: 0;
				font: 500 12px "IBM Plex Mono", monospace;
				letter-spacing: 0.3em;
				color: #7d8794;
			}
			.section-head a {
				font: 400 11px "IBM Plex Mono", monospace;
				color: #52e0f5;
			}
			.new-section > h2 {
				margin: 0 0 24px;
				font: 500 12px "IBM Plex Mono", monospace;
				letter-spacing: 0.3em;
				color: #7d8794;
			}

			.field-list,
			.new-list {
				display: flex;
				flex-direction: column;
			}
			.field-row {
				display: flex;
				align-items: baseline;
				gap: 36px;
				padding: 26px 0;
				border-top: 1px solid rgba(255, 255, 255, 0.1);
				transition: all 0.25s;
			}
			.field-list a.field-row:last-child {
				border-bottom: 1px solid rgba(255, 255, 255, 0.1);
			}
			.field-row:hover {
				color: #52e0f5;
				padding-left: 26px;
			}
			.field-row .no {
				font: 400 12px "IBM Plex Mono", monospace;
				color: #6d7a8f;
				width: 32px;
				flex-shrink: 0;
			}
			.field-row .major {
				font-size: 52px;
				font-weight: 900;
				letter-spacing: 0.02em;
				line-height: 1.1;
				text-wrap: pretty;
			}
			.field-row .count {
				margin-left: auto;
				font: 400 12px "IBM Plex Mono", monospace;
				color: #768190;
				white-space: nowrap;
			}

			.new-row {
				display: flex;
				align-items: center;
				gap: 28px;
				padding: 22px 0;
				border-top: 1px solid rgba(255, 255, 255, 0.09);
				transition: all 0.2s;
			}
			.new-list a.new-row:last-child {
				border-bottom: 1px solid rgba(255, 255, 255, 0.09);
			}
			.new-row:hover {
				background: rgba(82, 224, 245, 0.04);
				padding-left: 14px;
			}
			.new-row .id {
				font: 500 13px "IBM Plex Mono", monospace;
				color: #52e0f5;
				flex-shrink: 0;
			}
			.new-row .title {
				flex: 1;
				font-size: 17px;
				font-weight: 500;
			}
			.new-row .pill {
				font-size: 11px;
				color: #7d8794;
				padding: 4px 10px;
				border: 1px solid rgba(255, 255, 255, 0.12);
				border-radius: 999px;
				white-space: nowrap;
			}
			.new-row .dots {
				display: flex;
				gap: 4px;
				flex-shrink: 0;
			}
			.new-row .dots span {
				width: 6px;
				height: 6px;
				border-radius: 50%;
				background: #2a3340;
			}
			.new-row .dots span.on {
				background: #52e0f5;
			}
			.new-row .date {
				font: 400 11px "IBM Plex Mono", monospace;
				color: #6d7a8f;
				flex-shrink: 0;
			}
			.empty-note {
				padding: 26px 0;
				border-top: 1px solid rgba(255, 255, 255, 0.09);
				color: #7d8794;
				font-size: 14px;
			}

			.site-footer {
				display: flex;
				justify-content: space-between;
				padding: 24px 48px;
				border-top: 1px solid rgba(255, 255, 255, 0.07);
				font: 400 10px "IBM Plex Mono", monospace;
				color: #6d7a8f;
				letter-spacing: 0.1em;
				flex-wrap: wrap;
				gap: 8px;
			}

			/* ---------- モバイル: 演出を静的ヒーローに差し替える ---------- */
			@media (max-width: 860px) {
				.site-nav {
					padding: 18px 24px;
				}
				.site-nav .brand span {
					display: none;
				}
				.site-nav .links {
					gap: 16px;
					font-size: 12px;
				}
				/* #118: モバイルもデスクトップと同じ #track スクロール駆動演出を使う
				   （Yu 指示 2026-08-08。旧・静的な #mobile-hero は廃止）。
				   キャプション・固定 UI はモバイル幅向けに縮小・再配置する。
				   下部の固定タブ(BottomTabNav)と重ならないよう bottom オフセットを確保する。 */
				#c1 {
					gap: 12px;
				}
				#c1 .eyebrow {
					font-size: 9px;
					letter-spacing: 0.26em;
					padding: 0 20px;
				}
				#c1 p {
					font-size: 15px;
					padding: 0 24px;
				}
				#c-gamma,
				#c-beta {
					left: 24px;
					right: 24px;
					max-width: none;
				}
				#c-gamma h2,
				#c-beta h2 {
					font-size: 26px;
				}
				#c-gamma .formula,
				#c-beta .formula {
					font-size: 15px;
				}
				#c-gamma p,
				#c-beta p {
					font-size: 13px;
				}
				#c3 p {
					font-size: 15px;
					padding: 0 24px;
					text-align: center;
				}
				#c4 h2 {
					font-size: 30px;
					padding: 0 24px;
				}
				#c4 .cta {
					flex-direction: column;
					width: 100%;
					padding: 0 24px;
				}
				#c4 .cta a {
					text-align: center;
				}
				.scene-indicator {
					right: 18px;
					gap: 8px;
				}
				.scene-indicator .bar {
					height: 70px;
				}
				.stage-stats {
					left: 24px;
					right: 24px;
					bottom: calc(88px + env(safe-area-inset-bottom, 0px));
					gap: 20px;
					flex-wrap: wrap;
				}
				.fields-section,
				.new-section {
					padding-left: 24px;
					padding-right: 24px;
				}
				.fields-section {
					padding-top: 56px;
				}
				.field-row .major {
					font-size: 30px;
				}
				.field-row {
					gap: 16px;
				}
				.new-row {
					flex-wrap: wrap;
					gap: 10px;
					padding: 18px 0;
				}
				.new-row .title {
					flex-basis: 100%;
					order: 1;
				}
				.site-footer {
					padding: 20px 24px;
					flex-direction: column;
					padding-bottom: 90px;
				}
			}

			/* ---------- 縮退: 演出停止・Diary の静止形のみ ---------- */
			@media (prefers-reduced-motion: reduce) {
				#track {
					height: 100vh;
				}
				#stage {
					position: relative;
				}
				#c-gamma,
				#c-beta,
				#c3,
				#c4 {
					display: none;
				}
				#c1 {
					opacity: 1;
					transform: none;
				}
				.scene-indicator,
				#cur,
				#curdot {
					display: none;
				}
				.scroll-hint i {
					animation: none;
				}
			}
		</style>
	</head>
	<body>
		<LoadingCurtain />
		<header>
			<nav class="site-nav">
				<div class="brand">
					<strong>Diary</strong>
					<span>SELF-MADE MATHEMATICS</span>
				</div>
				<div class="links">
					<a href="/fields/">分野</a>
					<a href="#new">新着</a>
					<a href="/about/">About</a>
					<span class="kbd" data-search-open>検索<span>⌘K</span></span>
				</div>
			</nav>
		</header>

		<SearchModal />

		<main>
		<div id="cur" aria-hidden="true"></div>
		<div id="curdot" aria-hidden="true"></div>

		<div id="track">
			<div id="stage">
				<canvas id="fx" aria-hidden="true"></canvas>

				<div id="c1" class="caption">
					<div class="eyebrow">ORIGINAL ENTRANCE-EXAM MATHEMATICS</div>
					<p>理工系院試数学を自作、1000問へ。解く価値のある一問を。</p>
					<div class="scroll-hint">
						<span>SCROLL</span>
						<i></i>
					</div>
				</div>

				<div id="c-gamma" class="caption">
					<div class="eyebrow">GAMMA FUNCTION</div>
					<h2>Γ関数が描く<br />面積</h2>
					<div class="formula">{"Γ(4) = ∫₀^∞ x³e^(−x) dx = 3! = 6"}</div>
					<p>階乗を実数へ広げる関数。<br />面積として見れば 3! = 6 が現れる。</p>
				</div>

				{/*
				  #244: β関数のシーン（表示順は c1 → c2 → c-beta → c3 → c4）。
				  ID を c5 ではなく c-beta にしているのは、既存の #c1〜#c4 を
				  振り直すと CSS 側のブロックを全部書き換えることになり、
				  #63 で作り込んだ演出を壊すリスクが高いため。
				  レイアウトは #c-gamma と同一なので CSS セレクタを共有している。
				*/}
				<div id="c-beta" class="caption">
					<div class="eyebrow">BETA FUNCTION</div>
					<h2>β関数が描く<br />面積</h2>
					<div class="formula">{"B(2,3) = ∫₀¹ x(1−x)² dx = 1/12"}</div>
					<p>院試で頻出の特殊関数も、<br />面積として見れば値の意味がわかる。</p>
				</div>

				<div id="c3" class="caption">
					<div class="eyebrow">GOAL</div>
					<p>1000問を目指して、毎日つくる。</p>
				</div>

				<div id="c4" class="caption">
					<h2>解く価値のある、一問を。</h2>
					<div class="cta">
						<a href="/fields/" class="primary">分野から探す</a>
						<a href="#new" class="secondary">新着問題 →</a>
					</div>
				</div>

				<div class="scene-indicator">
					<span id="scn" class="num">01 / 05</span>
					<span class="bar"><i id="prog"></i></span>
				</div>

				<div class="stage-stats">
					<span>PROBLEMS <strong>{problemsPadded}</strong></span>
					<span>FIELDS <strong>{fieldsPadded}</strong></span>
					<span class="goal">GOAL <strong>1000+</strong></span>
				</div>
			</div>
		</div>

		<div class="after-stage">
			<section id="fields" class="fields-section">
				<div class="section-head">
					<h2>FIELDS — 分野から探す</h2>
					<a href="/fields/">ALL {fieldsPadded} →</a>
				</div>
				<div class="field-list">
					{
						fieldRows.map((f) => (
							<a href="/fields/" class="field-row">
								<span class="no">{f.no}</span>
								<span class="major">{f.major}</span>
								<span class="count">{f.count} 問</span>
							</a>
						))
					}
				</div>
			</section>

			<section id="new" class="new-section">
				<h2>LATEST — 新着問題</h2>
				<div class="new-list">
					{
						recent.length === 0 ? (
							<p class="empty-note">まだ公開された問題がありません。</p>
						) : (
							recent.map((p) => (
								<a href={`/problems/${p.id}/`} class="new-row">
									<span class="id">{p.id}</span>
									<span class="title">{formatMathTitle(p.title)}</span>
									<span class="pill">
										{p.field.major} / {p.field.minor}
									</span>
									<span class="dots">
										{difficultyDots(p.difficulty).map((on) => (
											<span class:list={[{ on }]} />
										))}
									</span>
									<span class="date">{formatDate(p.updated)}</span>
								</a>
							))
						)
					}
				</div>
			</section>
		</div>
		</main>

		<footer class="site-footer">
			<span>© 2026 DIARY — PERSONAL USE ONLY</span>
			<a href={issueHref} target="_blank" rel="noopener noreferrer">誤植報告 → GITHUB ISSUE</a>
		</footer>

		<BottomTabNav active="home" />

		<script>
			// トップページのスクロール駆動演出（design/01_top_scroll.dc.html 相当）。
			// パーティクルの生成・補間・描画ロジックは site/src/lib/particles/
			// （#62 の共通エンジン）に完全に委譲し、ここでは
			// 「スクロール進捗の区間割り当て」「キャプション/固定 UI の DOM 更新」
			// 「カスタムカーソルの追従」だけを行う。
			import {
				ParticleEngine,
				textShape,
				curvePoints,
				randomScatter,
				upwardScatter,
				alignSets,
				segmentProgress,
				lerpPoint,
				type SegmentTable,
			} from "../lib/particles";
			// #244: β関数のシーン。値の計算は #93 のプロトタイプで検証済みの
			// mathviz ライブラリを使い、被積分関数の定義を二重に持たない。
			import { betaIntegrand, gammaIntegrand } from "../lib/mathviz/gamma";

			const track = document.getElementById("track") as HTMLDivElement | null;
			const canvas = document.getElementById("fx") as HTMLCanvasElement | null;

			// #118 (Yu 指示 2026-08-08): モバイル幅でもデスクトップと同じ #track
			// スクロール駆動演出を使う（旧・静的ヒーローの #mobile-hero は廃止）。
			// 実機の発熱・fps を考慮し、モバイルでは以下を軽量化する:
			//   - パーティクル数: 2000 → 900（約 55% 減。textShape/curvePoints/
			//     upwardScatter すべてに適用）
			//   - devicePixelRatio 上限: 1.5 → 1（Retina 端末での描画負荷を抑える）
			//   - マウス反発: touch 端末では mousemove が発生しないため無効化
			// シーン数(4)自体はデスクトップと揃えるという Yu 指示の趣旨に沿って
			// 変更しない。スクロール量に対する進捗の割り当て(SEGMENTS)も共通のまま。
			const isMobile = window.matchMedia("(max-width: 860px)").matches;
			const PARTICLE_COUNT = isMobile ? 900 : 2000;

			if (canvas && track) {
				// Yu 指示(2026-08-08): 冒頭は「Diary 静止 → 散らばり」の順に変更
				// (ローディング演出が Diary 収束で終わるため、地続きに見せる)。
				// 以降(グラフ → 1000+ → 上方拡散)は design/README.md のまま。
				// #244: β関数のシーンを「放物線グラフ」と「1000+」の間に挿入した。
				// 各シーンのスクロール長は変えず、増えたぶん #track を 560vh →
				// 720vh に伸ばしている（旧 1.0 に対し新 1.28 倍を 1.0 に正規化）。
				// セット: 0=散らばり 1=Diary 2=放物線グラフ 3=β関数 4=1000+ 5=上方拡散
				const SEGMENTS: SegmentTable = [
					[0, 0.109, 1, 1],
					[0.109, 0.203, 1, 0],
					[0.203, 0.328, 0, 2],
					[0.328, 0.438, 2, 2],
					[0.438, 0.547, 2, 3],
					[0.547, 0.656, 3, 3],
					[0.656, 0.766, 3, 4],
					[0.766, 0.844, 4, 4],
					[0.844, 1.001, 4, 5],
				];

				let sets: ReturnType<typeof alignSets>;
				// #244: Γ関数シーン用のスケール
				let gx: (u: number) => number;
				let gy: (v: number) => number;
				// #244: β関数シーン用のスケール（Γ とは軸の範囲が違う）
				let bx: (u: number) => number;
				let by: (v: number) => number;
				let builtKey = "";

				function buildSets(w: number, h: number) {
					const scatter = randomScatter(PARTICLE_COUNT, w, h);
					const diary = textShape("Diary", {
						width: w,
						height: h,
						fontPx: Math.min(w * 0.24, 340),
						centerY: h * 0.42,
					});
					// #244: Γ(4) = ∫₀^∞ x³e^(-x) dx = 3! = 6 の被積分関数。
					// ピークは x = s-1 = 3 で値は 27e^(-3) ≈ 1.344。裾は x = 12 で
					// 打ち切る（x³e^(-x) は x=12 で約 0.0106 まで落ちる）。
					// 被積分関数の定義は mathviz の gammaIntegrand に委ねる。
					const GAMMA_S = 4;
					const L = w > 900 ? w * 0.46 : w * 0.1;
					const R = w > 900 ? w * 0.95 : w * 0.9;
					const T = h * 0.2;
					const B = h * 0.8;
					gx = (u: number) => L + ((u + 0.7) / 13.4) * (R - L);
					gy = (v: number) => B - ((v + 0.12) / 1.62) * (B - T);
					const gammaCurve = curvePoints([
						{
							from: 0.001,
							to: 12,
							step: 0.04,
							fn: (u) => ({ x: gx(u), y: gy(gammaIntegrand(GAMMA_S, u)) }),
						},
						{ from: -0.7, to: 12.7, step: 0.16, fn: (u) => ({ x: gx(u), y: gy(0) }) },
						{ from: -0.12, to: 1.5, step: 0.026, fn: (v) => ({ x: gx(0), y: gy(v) }) },
					]);
					const thousand = textShape("1000+", {
						width: w,
						height: h,
						fontPx: Math.min(w * 0.22, 300),
						centerY: h * 0.44,
					});
					// #244: β関数 B(2,3) = ∫₀¹ x(1-x)² dx の被積分関数。
					// 最大値は x = 1/3 の 4/27 ≈ 0.148 なので、縦は [-0.02, 0.19] で取る。
					// 被積分関数の定義は mathviz の betaIntegrand に委ねる（二重定義しない）。
					const BETA_P = 2;
					const BETA_Q = 3;
					const bL = w > 900 ? w * 0.46 : w * 0.1;
					const bR = w > 900 ? w * 0.95 : w * 0.9;
					const bT = h * 0.2;
					const bB = h * 0.8;
					bx = (u: number) => bL + ((u + 0.12) / 1.24) * (bR - bL);
					by = (v: number) => bB - ((v + 0.02) / 0.21) * (bB - bT);
					const betaCurve = curvePoints([
						{
							from: 0.001,
							to: 0.999,
							step: 0.0035,
							fn: (u) => ({ x: bx(u), y: by(betaIntegrand(BETA_P, BETA_Q, u)) }),
						},
						{ from: -0.12, to: 1.12, step: 0.014, fn: (u) => ({ x: bx(u), y: by(0) }) },
						{ from: -0.02, to: 0.19, step: 0.0035, fn: (v) => ({ x: bx(0), y: by(v) }) },
					]);
					const up = upwardScatter(PARTICLE_COUNT, w, h);
					return alignSets([scatter, diary, gammaCurve, betaCurve, thousand, up]);
				}

				function ensureSets() {
					const w = window.innerWidth;
					const h = window.innerHeight;
					const key = `${w}x${h}`;
					if (key !== builtKey) {
						sets = buildSets(w, h);
						builtKey = key;
						engine.setParticleCount(sets[0].length);
					}
				}

				const engine = new ParticleEngine(canvas, {
					dprMax: isMobile ? 1 : 1.5,
					mouseRepel: isMobile ? false : { radius: 120, strength: 5 },
				});
				if (!engine.reducedMotion && !isMobile) {
					engine.enableMouseTracking();
				}
				ensureSets();

				const c1 = document.getElementById("c1");
				const cGamma = document.getElementById("c-gamma");
				const cBeta = document.getElementById("c-beta");
				const c3 = document.getElementById("c3");
				const c4 = document.getElementById("c4");
				const scn = document.getElementById("scn");
				const prog = document.getElementById("prog");
				const cur = document.getElementById("cur");
				const curdot = document.getElementById("curdot");
				let cx = 0;
				let cy = 0;

				// #244: ランプ幅はスクロール進捗 p の割合で効くため、#track を
				// 560vh → 720vh（1.28 倍）に伸ばすと 0.05 のままでは実スクロール距離で
				// フェードが 28% 間延びする。元の見え方（約 28vh でフェード）を保つため
				// 0.05 / 1.28 ≈ 0.039 に詰める。
				const FADE_RAMP = 0.039;
				function fade(p: number, a: number, b: number): number {
					const fi = Math.min(Math.max((p - a) / FADE_RAMP, 0), 1);
					const fo = Math.min(Math.max((b - p) / FADE_RAMP, 0), 1);
					return Math.min(fi, fo);
				}

				function applyCaption(el: HTMLElement | null, opacity: number) {
					if (!el) return;
					el.style.opacity = String(opacity);
					el.style.transform = `translateY(${(1 - opacity) * 26}px)`;
					if (el.id === "c4") el.style.pointerEvents = opacity > 0.5 ? "auto" : "none";
				}

				let currentP = 0;

				function getScrollProgress(): number {
					if (!track) return 0;
					const r = track.getBoundingClientRect();
					const denom = r.height - window.innerHeight;
					if (denom <= 0) return 1;
					return Math.min(Math.max(-r.top / denom, 0), 1);
				}

				engine.start(
					(i) => {
						if (engine.reducedMotion) {
							// 静止形: Diary の文字形（セット 1）で止める。
							return sets[1][i];
						}
						const { from, to, t } = segmentProgress(currentP, SEGMENTS);
						return lerpPoint(sets[from][i], sets[to][i], t);
					},
					(frame) => {
						if (engine.reducedMotion) return;

						ensureSets();
						currentP = getScrollProgress();
						const { from, to, t } = segmentProgress(currentP, SEGMENTS);

						// あるセットが支配的な間だけ、そのシーンの「面積」を塗る。
						// セット 2 = Γ関数、セット 3 = β関数。いずれも被積分関数の下側を塗る（#244）。
						const setWeight = (target: number) => {
							if (from === target && to === target) return 1;
							if (to === target) return t;
							if (from === target) return 1 - t;
							return 0;
						};

						const gammaWeight = setWeight(2);
						if (gammaWeight > 0.02 && gx && gy) {
							const ctx = frame.ctx;
							ctx.save();
							ctx.globalAlpha = gammaWeight * 0.9;
							ctx.beginPath();
							ctx.moveTo(gx(0), gy(0));
							for (let u = 0; u <= 12.001; u += 0.06) {
								ctx.lineTo(gx(u), gy(gammaIntegrand(4, u)));
							}
							ctx.lineTo(gx(12), gy(0));
							ctx.closePath();
							ctx.fillStyle = "rgba(82,224,245,0.13)";
							ctx.fill();
							ctx.restore();
						}

						const betaWeight = setWeight(3);
						if (betaWeight > 0.02 && bx && by) {
							const ctx = frame.ctx;
							ctx.save();
							ctx.globalAlpha = betaWeight * 0.9;
							ctx.beginPath();
							ctx.moveTo(bx(0), by(0));
							for (let u = 0; u <= 1.0001; u += 0.005) {
								ctx.lineTo(bx(u), by(betaIntegrand(2, 3, u)));
							}
							ctx.lineTo(bx(1), by(0));
							ctx.closePath();
							ctx.fillStyle = "rgba(82,224,245,0.13)";
							ctx.fill();
							ctx.restore();
						}

						// #244: シーンが 1 つ増えたぶん、旧値を 1.28 で割って詰め直している。
						applyCaption(c1, fade(currentP, -1, 0.102));
						applyCaption(cGamma, fade(currentP, 0.234, 0.455));
						applyCaption(cBeta, fade(currentP, 0.465, 0.665));
						applyCaption(c3, fade(currentP, 0.675, 0.86));
						applyCaption(c4, currentP > 0.875 ? Math.min((currentP - 0.875) / 0.04, 1) : 0);

						if (scn) {
							// #244: 各シーンの「次への遷移が始まる位置」で番号を送る（旧実装と同じ考え方）。
							const n =
								currentP < 0.203
									? 1
									: currentP < 0.438
										? 2
										: currentP < 0.656
											? 3
											: currentP < 0.844
												? 4
												: 5;
							const txt = `0${n} / 05`;
							if (scn.textContent !== txt) scn.textContent = txt;
						}
						if (prog) prog.style.transform = `scaleY(${currentP})`;

						if (cur && curdot && !isMobile) {
							cx += (frame.mouse.x - cx) * 0.14;
							cy += (frame.mouse.y - cy) * 0.14;
							cur.style.transform = `translate(${cx - 17}px,${cy - 17}px)`;
							curdot.style.transform = `translate(${frame.mouse.x - 3}px,${frame.mouse.y - 3}px)`;
						}
					}
				);

				window.addEventListener("resize", () => {
					ensureSets();
				});
			}
		</script>
	</body>
</html>
