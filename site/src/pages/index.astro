---
// トップページ（#63 M1-D2: design/01_top_scroll.dc.html の High-fidelity 実装）。
//
// - スクロール駆動パーティクル演出は site/src/lib/particles/（#62）を使用。
//   このページでは新規に canvas 描画ロジックを書かない（不足があれば改修せず
//   README に不足を記録して回避策を取る運用。site/CLAUDE.md 例外規定参照）。
// - 統計・分野・新着は #61 の site-data.ts 経由で実データから生成する
//   （0042 / 18 のような数値のハードコード禁止。design/README.md 実装時の注意 6）。
// - prefers-reduced-motion: reduce では演出を停止し、Diary の静止形のみを表示する。
//   キャプション等のテキストは通常表示のまま（site/CLAUDE.md 必須条件）。
// - モバイル幅（<=860px）でも #track のスクロール駆動演出をそのまま使う
//   （#118, Yu 指示 2026-08-08。site/CLAUDE.md の例外条項を上書き）。
//   ただし発熱・fps を考慮し、パーティクル数と canvas の devicePixelRatio 上限を
//   モバイルで下げて軽量化する（詳細は script 内コメント参照）。
import { computeSiteStats } from "../lib/site-data";
import LoadingCurtain from "../components/LoadingCurtain.astro";
import SearchModal from "../components/SearchModal.astro";
import BottomTabNav from "../components/BottomTabNav.astro";
import { formatMathTitle } from "../lib/title";
import SiteHead from "../components/SiteHead.astro";
import DifficultyBadge from "../components/DifficultyBadge.astro";

const stats = computeSiteStats();

const fieldRows = stats.byField.map((f, i) => ({
	no: String(i + 1).padStart(2, "0"),
	major: f.major,
	count: f.count,
}));

const recent = stats.recent;

function formatDate(d: string): string {
	return d ? d.replaceAll("-", ".") : "";
}

const problemsPadded = String(stats.problemCount).padStart(4, "0");
const fieldsPadded = String(stats.fieldCount).padStart(2, "0");

const issueHref =
	"https://github.com/yu531deve/diary/issues/new?labels=typo&title=" +
	encodeURIComponent("[誤植報告] トップページ");
---

<!doctype html>
<html lang="ja">
	<head>
		<SiteHead
			title="Diary — 理工系院試数学 自作問題集"
			description="理工系大学院入試の自作数学問題を公開しています。解く価値のある一問を、1000問へ。"
		/>
		<style>
			:root {
				color-scheme: dark;
			}
			* {
				box-sizing: border-box;
			}
			body {
				margin: 0;
				background: #05060a;
				color: #eef2f6;
				font-family: "Noto Sans JP", sans-serif;
			}
			a {
				color: inherit;
				text-decoration: none;
			}
			a:hover {
				opacity: 0.8;
			}
			::selection {
				background: #52e0f5;
				color: #05060a;
			}

			@keyframes scrollpulse {
				0%,
				100% {
					transform: translateY(0);
					opacity: 0.9;
				}
				50% {
					transform: translateY(8px);
					opacity: 0.4;
				}
			}

			/* ---------- 固定ヘッダー ---------- */
			.site-nav {
				position: fixed;
				top: 0;
				left: 0;
				right: 0;
				z-index: 20;
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 26px 48px;
				background: linear-gradient(180deg, rgba(5, 6, 10, 0.85), rgba(5, 6, 10, 0));
			}
			.site-nav .brand {
				display: flex;
				align-items: baseline;
				gap: 12px;
			}
			.site-nav .brand strong {
				font: 700 19px "Space Grotesk", sans-serif;
			}
			.site-nav .brand span {
				font: 400 10px "IBM Plex Mono", monospace;
				color: #768190;
				letter-spacing: 0.18em;
			}
			.site-nav .links {
				display: flex;
				align-items: center;
				gap: 32px;
				font-size: 13px;
				color: #aeb6c2;
			}
			.site-nav .links a {
				white-space: nowrap;
			}
			.site-nav .kbd {
				display: flex;
				align-items: center;
				gap: 8px;
				padding: 7px 14px;
				border: 1px solid rgba(255, 255, 255, 0.14);
				border-radius: 999px;
				font: 400 11px "IBM Plex Mono", monospace;
				color: #7d8794;
			}
			.site-nav .kbd span {
				color: #6d7a8f;
			}

			/* ---------- カスタムカーソル ---------- */
			#cur {
				position: fixed;
				top: 0;
				left: 0;
				width: 34px;
				height: 34px;
				border: 1px solid rgba(82, 224, 245, 0.8);
				border-radius: 50%;
				pointer-events: none;
				z-index: 60;
				mix-blend-mode: screen;
			}
			#curdot {
				position: fixed;
				top: 0;
				left: 0;
				width: 6px;
				height: 6px;
				border-radius: 50%;
				background: #52e0f5;
				pointer-events: none;
				z-index: 60;
			}
			@media (hover: none), (pointer: coarse) {
				#cur,
				#curdot {
					display: none;
				}
			}

			/* ---------- スクロール演出トラック ---------- */
			#track {
				position: relative;
				/* シーン数 7（数式図形 4 シーン化）に合わせて延長 */
				height: 1250vh;
				/* iOS Safari 等でアドレスバーの伸縮により 100vh がずれるため、
				   対応ブラウザでは svh を優先する（未対応時は上の vh 指定が残る）。 */
				height: 1250svh;
			}
			#stage {
				position: sticky;
				top: 0;
				height: 100vh;
				height: 100svh;
				overflow: hidden;
			}
			#fx {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				display: block;
			}
			.caption {
				position: absolute;
				opacity: 0;
			}
			#c1 {
				left: 0;
				right: 0;
				top: 64vh;
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 18px;
				opacity: 1;
			}
			#c1 .eyebrow {
				font: 500 11px "IBM Plex Mono", monospace;
				letter-spacing: 0.34em;
				color: #52e0f5;
				text-align: center;
			}
			#c1 h1 {
				margin: 0;
				font-size: 18px;
				font-weight: 500;
				font-family: inherit;
				color: #c3ccd8;
				letter-spacing: 0.06em;
				text-align: center;
			}
			#c1 .scroll-hint {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 8px;
				margin-top: 14px;
				font: 400 10px "IBM Plex Mono", monospace;
				color: #768190;
				letter-spacing: 0.3em;
			}
			#c1 .scroll-hint i {
				display: block;
				width: 1px;
				height: 34px;
				background: linear-gradient(180deg, #52e0f5, transparent);
				animation: scrollpulse 2s ease-in-out infinite;
			}
			/* 数式シーン共通キャプション（c2〜c5）。全シーン左側固定（旧 #c2 と同位置） */
			.fcap {
				left: 48px;
				top: 0;
				height: 100vh;
				height: 100svh;
				display: flex;
				flex-direction: column;
				justify-content: center;
				gap: 20px;
				max-width: 440px;
			}
			.fcap .eyebrow {
				font: 500 11px "IBM Plex Mono", monospace;
				letter-spacing: 0.24em;
				color: #52e0f5;
			}
			.fcap h2 {
				margin: 0;
				font-size: 40px;
				font-weight: 900;
				line-height: 1.35;
				text-wrap: pretty;
			}
			.fcap .formula {
				font: italic 400 21px "STIX Two Text", serif;
				color: #aab6d4;
			}
			.fcap p {
				margin: 0;
				font-size: 14px;
				line-height: 1.9;
				color: #7d8794;
			}
			#c6 {
				left: 0;
				right: 0;
				top: 66vh;
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 12px;
			}
			#c6 .eyebrow {
				font: 500 11px "IBM Plex Mono", monospace;
				letter-spacing: 0.3em;
				color: #52e0f5;
			}
			#c6 p {
				margin: 0;
				font-size: 19px;
				font-weight: 500;
				color: #c3ccd8;
			}
			#c7 {
				left: 0;
				right: 0;
				top: 0;
				height: 100vh;
				height: 100svh;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				gap: 26px;
				pointer-events: none;
			}
			#c7 h2 {
				margin: 0;
				font-size: 56px;
				font-weight: 900;
				letter-spacing: 0.02em;
				text-align: center;
				text-wrap: pretty;
			}
			#c7 .cta {
				display: flex;
				gap: 14px;
			}
			#c7 .cta a.primary {
				padding: 15px 32px;
				background: #52e0f5;
				color: #06232a;
				font-weight: 700;
				font-size: 14px;
				border-radius: 2px;
			}
			#c7 .cta a.secondary {
				padding: 15px 32px;
				border: 1px solid rgba(255, 255, 255, 0.25);
				color: #dfe6ee;
				font-size: 14px;
				border-radius: 2px;
			}

			.scene-indicator {
				position: absolute;
				right: 48px;
				top: 50%;
				transform: translateY(-50%);
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 14px;
			}
			.scene-indicator .num {
				font: 400 11px "IBM Plex Mono", monospace;
				color: #7d8794;
				letter-spacing: 0.2em;
			}
			.scene-indicator .bar {
				display: block;
				width: 1px;
				height: 120px;
				background: rgba(255, 255, 255, 0.12);
				position: relative;
				overflow: hidden;
			}
			.scene-indicator .bar i {
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				background: #52e0f5;
				transform: scaleY(0);
				transform-origin: top;
			}

			.stage-stats {
				position: absolute;
				left: 48px;
				bottom: 32px;
				display: flex;
				gap: 36px;
				font: 400 11px "IBM Plex Mono", monospace;
				color: #768190;
				letter-spacing: 0.12em;
			}
			.stage-stats strong {
				color: #dfe6ee;
				font-weight: 400;
			}
			.stage-stats .goal strong {
				color: #52e0f5;
			}


			/* ---------- スクロール後のセクション ---------- */
			.after-stage {
				position: relative;
				z-index: 1;
				background: #05060a;
			}
			.fields-section,
			.new-section {
				padding: 40px 48px 90px;
				max-width: 1400px;
				margin: 0 auto;
			}
			.fields-section {
				padding-top: 120px;
			}
			.section-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				margin-bottom: 34px;
			}
			.section-head h2 {
				margin: 0;
				font: 500 12px "IBM Plex Mono", monospace;
				letter-spacing: 0.3em;
				color: #7d8794;
			}
			.section-head a {
				font: 400 11px "IBM Plex Mono", monospace;
				color: #52e0f5;
			}
			.new-section-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 16px;
				margin-bottom: 24px;
			}
			.new-section-head h2 {
				margin: 0;
				font: 500 12px "IBM Plex Mono", monospace;
				letter-spacing: 0.3em;
				color: #7d8794;
			}
			.new-section-head .difficulty-legend-link {
				font: 400 11px "IBM Plex Mono", monospace;
				color: #768190;
				text-decoration: none;
				white-space: nowrap;
			}
			.new-section-head .difficulty-legend-link:hover {
				color: #52e0f5;
			}

			.field-list,
			.new-list {
				display: flex;
				flex-direction: column;
			}
			.field-row {
				display: flex;
				align-items: baseline;
				gap: 36px;
				padding: 26px 0;
				border-top: 1px solid rgba(255, 255, 255, 0.1);
				transition: all 0.25s;
			}
			.field-list a.field-row:last-child {
				border-bottom: 1px solid rgba(255, 255, 255, 0.1);
			}
			.field-row:hover {
				color: #52e0f5;
				padding-left: 26px;
			}
			.field-row .no {
				font: 400 12px "IBM Plex Mono", monospace;
				color: #6d7a8f;
				width: 32px;
				flex-shrink: 0;
			}
			.field-row .major {
				font-size: 52px;
				font-weight: 900;
				letter-spacing: 0.02em;
				line-height: 1.1;
				text-wrap: pretty;
			}
			.field-row .count {
				margin-left: auto;
				font: 400 12px "IBM Plex Mono", monospace;
				color: #768190;
				white-space: nowrap;
			}

			.new-row {
				display: flex;
				align-items: center;
				gap: 28px;
				padding: 22px 0;
				border-top: 1px solid rgba(255, 255, 255, 0.09);
				transition: all 0.2s;
			}
			.new-list a.new-row:last-child {
				border-bottom: 1px solid rgba(255, 255, 255, 0.09);
			}
			.new-row:hover {
				background: rgba(82, 224, 245, 0.04);
				padding-left: 14px;
			}
			.new-row .id {
				font: 500 13px "IBM Plex Mono", monospace;
				color: #52e0f5;
				flex-shrink: 0;
			}
			.new-row .title {
				flex: 1;
				font-size: 17px;
				font-weight: 500;
			}
			.new-row .pill {
				font-size: 11px;
				color: #7d8794;
				padding: 4px 10px;
				border: 1px solid rgba(255, 255, 255, 0.12);
				border-radius: 999px;
				white-space: nowrap;
			}
			.new-row .date {
				font: 400 11px "IBM Plex Mono", monospace;
				color: #6d7a8f;
				flex-shrink: 0;
			}
			.empty-note {
				padding: 26px 0;
				border-top: 1px solid rgba(255, 255, 255, 0.09);
				color: #7d8794;
				font-size: 14px;
			}

			.site-footer {
				display: flex;
				justify-content: space-between;
				padding: 24px 48px;
				border-top: 1px solid rgba(255, 255, 255, 0.07);
				font: 400 10px "IBM Plex Mono", monospace;
				color: #6d7a8f;
				letter-spacing: 0.1em;
				flex-wrap: wrap;
				gap: 8px;
			}

			/* ---------- モバイル: 演出を静的ヒーローに差し替える ---------- */
			@media (max-width: 860px) {
				.site-nav {
					padding: 18px 24px;
				}
				.site-nav .brand span {
					display: none;
				}
				.site-nav .links {
					gap: 16px;
					font-size: 12px;
				}
				/* #118: モバイルもデスクトップと同じ #track スクロール駆動演出を使う
				   （Yu 指示 2026-08-08。旧・静的な #mobile-hero は廃止）。
				   キャプション・固定 UI はモバイル幅向けに縮小・再配置する。
				   下部の固定タブ(BottomTabNav)と重ならないよう bottom オフセットを確保する。 */
				#c1 {
					gap: 12px;
				}
				#c1 .eyebrow {
					font-size: 9px;
					letter-spacing: 0.26em;
					padding: 0 20px;
				}
				#c1 h1 {
					font-size: 15px;
					padding: 0 24px;
				}
				.fcap {
					left: 24px;
					right: 24px;
					max-width: none;
				}
				.fcap h2 {
					font-size: 26px;
				}
				.fcap .formula {
					font-size: 15px;
				}
				.fcap p {
					font-size: 13px;
				}
				#c6 p {
					font-size: 15px;
					padding: 0 24px;
					text-align: center;
				}
				#c7 h2 {
					font-size: 30px;
					padding: 0 24px;
				}
				#c7 .cta {
					flex-direction: column;
					width: 100%;
					padding: 0 24px;
				}
				#c7 .cta a {
					text-align: center;
				}
				.scene-indicator {
					right: 18px;
					gap: 8px;
				}
				.scene-indicator .bar {
					height: 70px;
				}
				.stage-stats {
					left: 24px;
					right: 24px;
					bottom: calc(88px + env(safe-area-inset-bottom, 0px));
					gap: 20px;
					flex-wrap: wrap;
				}
				.fields-section,
				.new-section {
					padding-left: 24px;
					padding-right: 24px;
				}
				.fields-section {
					padding-top: 56px;
				}
				.field-row .major {
					font-size: 30px;
				}
				.field-row {
					gap: 16px;
				}
				.new-row {
					flex-wrap: wrap;
					gap: 10px;
					padding: 18px 0;
				}
				.new-row .title {
					flex-basis: 100%;
					order: 1;
				}
				.site-footer {
					padding: 20px 24px;
					flex-direction: column;
					padding-bottom: 90px;
				}
			}

			/* ---------- 縮退: 演出停止・Diary の静止形のみ ---------- */
			@media (prefers-reduced-motion: reduce) {
				#track {
					height: 100vh;
				}
				#stage {
					position: relative;
				}
				.fcap,
				#c6,
				#c7 {
					display: none;
				}
				#c1 {
					opacity: 1;
					transform: none;
				}
				.scene-indicator,
				#cur,
				#curdot {
					display: none;
				}
				.scroll-hint i {
					animation: none;
				}
			}
		</style>
	</head>
	<body>
		<LoadingCurtain />
		<header>
			<nav class="site-nav">
				<div class="brand">
					<strong>Diary</strong>
					<span>SELF-MADE MATHEMATICS</span>
				</div>
				<div class="links">
					<a href="/fields/">分野</a>
					<a href="#new">新着</a>
					<a href="/archive/">アーカイブ</a>
					<a href="/about/">About</a>
					<span class="kbd" data-search-open>検索<span>⌘K</span></span>
				</div>
			</nav>
		</header>

		<SearchModal />

		<main>
		<div id="cur" aria-hidden="true"></div>
		<div id="curdot" aria-hidden="true"></div>

		<div id="track">
			<div id="stage">
				<canvas id="fx" aria-hidden="true"></canvas>

				<div id="c1" class="caption">
					<div class="eyebrow">ORIGINAL GRADUATE-EXAM MATHEMATICS</div>
					<h1>理工系院試数学を自作、1000問へ。解く価値のある一問を。</h1>
					<div class="scroll-hint">
						<span>SCROLL</span>
						<i></i>
					</div>
				</div>

				<div id="c2" class="caption fcap">
					<div class="eyebrow">VECTOR ANALYSIS — ベクトル解析</div>
					<h2>閉曲線が<br />囲む面積</h2>
					<div class="formula">{"∮C (x dy − y dx) = 2S"}</div>
					<p>グリーンの定理。<br />境界を一周すれば、内部が分かる。</p>
				</div>

				<div id="c3" class="caption fcap">
					<div class="eyebrow">CALCULUS — 微分積分学</div>
					<h2>釣鐘の下に<br />隠れた円周率</h2>
					<div class="formula">{"∫₋∞^∞ e^(−x²) dx = √π"}</div>
					<p>ガウス積分。<br />一次元では解けず、二次元で解ける。</p>
				</div>

				<div id="c4" class="caption fcap">
					<div class="eyebrow">STATISTICS — 統計学</div>
					<h2>足し合わせは<br />正規分布へ</h2>
					<div class="formula">{"(X̄ − μ)/(σ/√n) → N(0, 1)"}</div>
					<p>中心極限定理。<br />どんな分布も、平均は釣鐘に収束する。</p>
				</div>

				<div id="c5" class="caption fcap">
					<div class="eyebrow">LINEAR ALGEBRA — 線形代数</div>
					<h2>行列式は<br />面積の倍率</h2>
					<div class="formula">{"det A = 3 — 面積は 3 倍に"}</div>
					<p>線形写像は円を楕円へうつす。<br />その面積比が行列式。</p>
				</div>

				<div id="c6" class="caption">
					<div class="eyebrow">GOAL</div>
					<p>1000問を目指して、毎日つくる。</p>
				</div>

				<div id="c7" class="caption">
					<h2>解く価値のある、一問を。</h2>
					<div class="cta">
						<a href="/fields/" class="primary">分野から探す</a>
						<a href="#new" class="secondary">新着問題 →</a>
					</div>
				</div>

				<div class="scene-indicator">
					<span id="scn" class="num">01 / 07</span>
					<span class="bar"><i id="prog"></i></span>
				</div>

				<div class="stage-stats">
					<span>PROBLEMS <strong>{problemsPadded}</strong></span>
					<span>FIELDS <strong>{fieldsPadded}</strong></span>
					<span class="goal">GOAL <strong>1000+</strong></span>
				</div>
			</div>
		</div>

		<div class="after-stage">
			<section id="fields" class="fields-section">
				<div class="section-head">
					<h2>FIELDS — 分野から探す</h2>
					<a href="/fields/">ALL {fieldsPadded} →</a>
				</div>
				<div class="field-list">
					{
						fieldRows.map((f) => (
							<a href="/fields/" class="field-row">
								<span class="no">{f.no}</span>
								<span class="major">{f.major}</span>
								<span class="count">{f.count} 問</span>
							</a>
						))
					}
				</div>
			</section>

			<section id="new" class="new-section">
				<div class="new-section-head">
					<h2>LATEST — 新着問題</h2>
					<a href="/about/#difficulty" class="difficulty-legend-link">難易度基準 →</a>
				</div>
				<div class="new-list">
					{
						recent.length === 0 ? (
							<p class="empty-note">まだ公開された問題がありません。</p>
						) : (
							recent.map((p) => (
								<a href={`/problems/${p.id}/`} class="new-row">
									<span class="id">{p.id}</span>
									<span class="title">{formatMathTitle(p.title)}</span>
									<span class="pill">
										{p.field.major} / {p.field.minor}
									</span>
									<DifficultyBadge difficulty={p.difficulty} compact />
									<span class="date">{formatDate(p.updated)}</span>
								</a>
							))
						)
					}
				</div>
			</section>
		</div>
		</main>

		<footer class="site-footer">
			<span>© 2026 DIARY — PERSONAL USE ONLY</span>
			<a href={issueHref} target="_blank" rel="noopener noreferrer">誤植報告 → GITHUB ISSUE</a>
		</footer>

		<BottomTabNav active="home" />

		<script>
			// トップページのスクロール駆動演出（design/01_top_scroll.dc.html 相当）。
			// パーティクルの生成・補間・描画ロジックは site/src/lib/particles/
			// （#62 の共通エンジン）に完全に委譲し、ここでは
			// 「スクロール進捗の区間割り当て」「キャプション/固定 UI の DOM 更新」
			// 「カスタムカーソルの追従」だけを行う。
			import {
				ParticleEngine,
				textShape,
				curvePoints,
				randomScatter,
				upwardScatter,
				alignSets,
				segmentProgress,
				lerpPoint,
				type SegmentTable,
			} from "../lib/particles";

			const track = document.getElementById("track") as HTMLDivElement | null;
			const canvas = document.getElementById("fx") as HTMLCanvasElement | null;

			// #118 (Yu 指示 2026-08-08): モバイル幅でもデスクトップと同じ #track
			// スクロール駆動演出を使う（旧・静的ヒーローの #mobile-hero は廃止）。
			// 実機の発熱・fps を考慮し、モバイルでは以下を軽量化する:
			//   - パーティクル数: 2000 → 900（約 55% 減。textShape/curvePoints/
			//     upwardScatter すべてに適用）
			//   - devicePixelRatio 上限: 1.5 → 1（Retina 端末での描画負荷を抑える）
			//   - マウス反発: touch 端末では mousemove が発生しないため無効化
			// シーン数(4)自体はデスクトップと揃えるという Yu 指示の趣旨に沿って
			// 変更しない。スクロール量に対する進捗の割り当て(SEGMENTS)も共通のまま。
			const isMobile = window.matchMedia("(max-width: 860px)").matches;
			const PARTICLE_COUNT = isMobile ? 900 : 2000;

			if (canvas && track) {
				// シーン構成（#figure: 数式図形 4 シーン化）:
				//   01 Diary 静止 → 散らばり（ローディング演出と地続き。Yu 指示 2026-08-08）
				//   02 ベクトル解析 — グリーンの定理（入れ子の閉曲線、内部を塗る）
				//   03 微分積分学 — ガウス積分（釣鐘、下を塗る）
				//   04 統計学     — 中心極限定理（ヒストグラム + 曲線）
				//   05 線形代数   — det A = 3（円 → 楕円、楕円を塗る）
				//   06 1000+ → 07 上方拡散 + CTA
				// セット番号: 0 scatter / 1 Diary / 2 green / 3 gauss / 4 clt / 5 det
				//             / 6 1000+ / 7 up
				// #248: スクロールに対して進みが速すぎたため、静止(0.09)を遷移(0.06)
				// より長くし、#track も 920vh → 1250vh に伸ばした。
				// 1 図形あたりの静止は 64vh → 113vh（1.76 倍）、遷移は 64vh → 75vh。
				const SEGMENTS: SegmentTable = [
					[0, 0.07, 1, 1],
					[0.07, 0.12, 1, 0],
					[0.12, 0.19, 0, 2],
					[0.19, 0.28, 2, 2],
					[0.28, 0.34, 2, 3],
					[0.34, 0.43, 3, 3],
					[0.43, 0.49, 3, 4],
					[0.49, 0.58, 4, 4],
					[0.58, 0.64, 4, 5],
					[0.64, 0.73, 5, 5],
					[0.73, 0.79, 5, 6],
					[0.79, 0.86, 6, 6],
					[0.86, 1.001, 6, 7],
				];

				// 図形セット番号 → 塗り描画関数（extraDraw から重み付きで呼ぶ）
				type FillFn = (ctx: CanvasRenderingContext2D, alpha: number) => void;

				let sets: ReturnType<typeof alignSets>;
				let fills: Map<number, FillFn>;
				let builtKey = "";

				function buildSets(w: number, h: number) {
					const TAU = Math.PI * 2;
					// 図形は画面短辺比でスケール。キャプションと反対側に寄せる
					// （モバイルはキャプションを下寄せにするため中央）。
					const narrow = w <= 860;
					const S = Math.min(w, h);
					// 曲線サンプリングの間引き係数。モバイルは点数を約半分にして
					// パーティクル総数を抑える（#118 の軽量化方針を曲線セットにも適用）。
					const k = isMobile ? 2 : 1;
					fills = new Map();

					const scatter = randomScatter(PARTICLE_COUNT, w, h);
					const diary = textShape("Diary", {
						width: w,
						height: h,
						fontPx: Math.min(w * 0.24, 340),
						centerY: h * 0.42,
					});

					// --- 02 グリーンの定理: 有機的な閉曲線 + 入れ子の輪 --------------
					// r(θ) = R(1 + 0.2cos3θ + 0.05sin7θ) の花弁状閉曲線を 3 重に。
					// 図形は全シーン右側（旧・放物線グラフと同じ側。左のキャプションを避ける）
					const figX = narrow ? w * 0.5 : w * 0.71;
					const gcx = figX;
					const gcy = narrow ? h * 0.4 : h * 0.48;
					const gR = S * (narrow ? 0.3 : 0.33);
					const blob = (t: number, s: number) => {
						const r = gR * s * (1 + 0.2 * Math.cos(3 * t) + 0.05 * Math.sin(7 * t));
						return { x: gcx + r * Math.cos(t), y: gcy + r * Math.sin(t) * 0.92 };
					};
					const green = curvePoints([
						{ from: 0, to: TAU, step: 0.008 * k, fn: (t) => blob(t, 1) },
						{ from: 0, to: TAU, step: 0.013 * k, fn: (t) => blob(t, 0.66) },
						{ from: 0, to: TAU, step: 0.022 * k, fn: (t) => blob(t, 0.36) },
						// 周回方向を示す接線チック（外周 12 箇所の短い斜め線）
						...Array.from({ length: 12 }, (_, k) => ({
							from: 0,
							to: 1,
							step: 0.2 * k,
							fn: (s: number) => {
								const t = (k / 12) * TAU;
								const p0 = blob(t, 1.1);
								const p1 = blob(t + 0.09, 1.14);
								return {
									x: p0.x + (p1.x - p0.x) * s,
									y: p0.y + (p1.y - p0.y) * s,
								};
							},
						})),
					]);
					fills.set(2, (ctx, alpha) => {
						// 中心が淡く光る放射グラデーションで、入れ子の輪ごとに重ね塗り
						const grad = ctx.createRadialGradient(gcx, gcy, gR * 0.05, gcx, gcy, gR * 1.25);
						grad.addColorStop(0, "rgba(82,224,245,0.2)");
						grad.addColorStop(0.55, "rgba(82,224,245,0.08)");
						grad.addColorStop(1, "rgba(82,224,245,0)");
						ctx.fillStyle = grad;
						for (const s of [1, 0.66, 0.36]) {
							ctx.globalAlpha = alpha * 0.55;
							ctx.beginPath();
							for (let t = 0; t <= TAU + 1e-6; t += 0.03) {
								const p = blob(t, s);
								t === 0 ? ctx.moveTo(p.x, p.y) : ctx.lineTo(p.x, p.y);
							}
							ctx.closePath();
							ctx.fill();
						}
					});

					// --- 03 ガウス積分: 左右対称の釣鐘 + 軸 + ±1 の目印 --------------
					const bcx = figX;
					const bBase = narrow ? h * 0.62 : h * 0.74;
					const bxs = (u: number) => bcx + (u / 2.7) * S * (narrow ? 0.42 : 0.36);
					const bys = (v: number) => bBase - v * S * (narrow ? 0.4 : 0.46);
					const bell = (u: number) => Math.exp(-u * u);
					const gauss = curvePoints([
						// 釣鐘本体（密）と、その相似形（e^{-x²/2}、淡い残像として疎に）
						{ from: -2.7, to: 2.7, step: 0.008 * k, fn: (u) => ({ x: bxs(u), y: bys(bell(u)) }) },
						{
							from: -2.7,
							to: 2.7,
							step: 0.05 * k,
							fn: (u) => ({ x: bxs(u), y: bys(Math.exp((-u * u) / 2) * 0.55) }),
						},
						// x 軸・対称軸
						{ from: -2.7, to: 2.7, step: 0.045 * k, fn: (u) => ({ x: bxs(u), y: bys(0) }) },
						{ from: 0, to: 1.06, step: 0.045 * k, fn: (v) => ({ x: bxs(0), y: bys(v) }) },
						// x = ±1 の縦の目印（点線状に疎らに）
						{ from: 0, to: bell(1), step: 0.06 * k, fn: (v) => ({ x: bxs(1), y: bys(v) }) },
						{ from: 0, to: bell(1), step: 0.06 * k, fn: (v) => ({ x: bxs(-1), y: bys(v) }) },
					]);
					fills.set(3, (ctx, alpha) => {
						// 頂点から x 軸へ落ちる縦グラデーション（裾ほど薄い）
						const grad = ctx.createLinearGradient(0, bys(1.06), 0, bys(0));
						grad.addColorStop(0, "rgba(82,224,245,0.22)");
						grad.addColorStop(1, "rgba(82,224,245,0.03)");
						ctx.globalAlpha = alpha * 0.9;
						ctx.beginPath();
						ctx.moveTo(bxs(-2.7), bys(0));
						for (let u = -2.7; u <= 2.701; u += 0.04) ctx.lineTo(bxs(u), bys(bell(u)));
						ctx.lineTo(bxs(2.7), bys(0));
						ctx.closePath();
						ctx.fillStyle = grad;
						ctx.fill();
					});

					// --- 04 中心極限定理: ヒストグラム + 正規曲線（唯一の離散） ------
					const ccx = figX;
					const cBase = narrow ? h * 0.62 : h * 0.76;
					const cxs = (u: number) => ccx + (u / 2.5) * S * (narrow ? 0.42 : 0.34);
					const cys = (v: number) => cBase - v * S * (narrow ? 0.38 : 0.44);
					const norm = (u: number) => Math.exp((-u * u) / 2);
					// 棒の高さは正規分布に決定的な凸凹を乗せる（乱数だと resize で変わる）
					const BAR_W = 0.46;
					const bars = Array.from({ length: 9 }, (_, k) => {
						const u = -2 + k * 0.5;
						return { u, hgt: Math.max(0.05, norm(u) * (1 + 0.16 * Math.sin(k * 2.9))) };
					});
					const cltSegs = bars.flatMap(({ u, hgt }) => [
						// 左辺・右辺・上辺で棒の輪郭を描く
						{ from: 0, to: hgt, step: 0.055 * k, fn: (v: number) => ({ x: cxs(u - BAR_W / 2), y: cys(v) }) },
						{ from: 0, to: hgt, step: 0.055 * k, fn: (v: number) => ({ x: cxs(u + BAR_W / 2), y: cys(v) }) },
						{
							from: -BAR_W / 2,
							to: BAR_W / 2,
							step: 0.075 * k,
							fn: (du: number) => ({ x: cxs(u + du), y: cys(hgt) }),
						},
					]);
					const clt = curvePoints([
						...cltSegs,
						// なめらかな正規曲線を重ねる（密）
						{ from: -2.6, to: 2.6, step: 0.012 * k, fn: (u) => ({ x: cxs(u), y: cys(norm(u) * 1.06) }) },
						// x 軸
						{ from: -2.6, to: 2.6, step: 0.05 * k, fn: (u) => ({ x: cxs(u), y: cys(0) }) },
					]);
					fills.set(4, (ctx, alpha) => {
						// 棒ごとに上端が明るい縦グラデーション
						ctx.globalAlpha = alpha * 0.9;
						for (const { u, hgt } of bars) {
							const x0 = cxs(u - BAR_W / 2);
							const yTop = cys(hgt);
							const grad = ctx.createLinearGradient(0, yTop, 0, cys(0));
							grad.addColorStop(0, "rgba(82,224,245,0.2)");
							grad.addColorStop(1, "rgba(82,224,245,0.02)");
							ctx.fillStyle = grad;
							ctx.fillRect(x0, yTop, cxs(u + BAR_W / 2) - x0, cys(0) - yTop);
						}
					});

					// --- 05 det A = 3: 単位円 → 楕円（面積 3 倍）+ 対応スポーク ------
					const dcx = figX;
					const dcy = narrow ? h * 0.4 : h * 0.5;
					const dr = S * (narrow ? 0.16 : 0.18);
					// 面積比 3: 半軸 2.1r × (3/2.1)r を -20° 回転
					const da = 2.1;
					const db = 3 / 2.1;
					const rot = -0.35;
					const circPt = (t: number) => ({
						x: dcx + dr * Math.cos(t),
						y: dcy + dr * Math.sin(t),
					});
					const ellPt = (t: number) => {
						const ex = da * dr * Math.cos(t);
						const ey = db * dr * Math.sin(t);
						return {
							x: dcx + ex * Math.cos(rot) - ey * Math.sin(rot),
							y: dcy + ex * Math.sin(rot) + ey * Math.cos(rot),
						};
					};
					const det = curvePoints([
						{ from: 0, to: TAU, step: 0.02 * k, fn: circPt },
						{ from: 0, to: TAU, step: 0.01 * k, fn: ellPt },
						// 対応する 12 方位を円周から楕円周へ結ぶスポーク（写像の可視化）
						...Array.from({ length: 12 }, (_, k) => ({
							from: 0,
							to: 1,
							step: 0.14 * k,
							fn: (s: number) => {
								const t = (k / 12) * TAU;
								const p0 = circPt(t);
								const p1 = ellPt(t);
								return {
									x: p0.x + (p1.x - p0.x) * s,
									y: p0.y + (p1.y - p0.y) * s,
								};
							},
						})),
					]);
					fills.set(5, (ctx, alpha) => {
						// 楕円は中心から放射状に減衰するグラデーションで塗る
						const grad = ctx.createRadialGradient(dcx, dcy, dr * 0.1, dcx, dcy, dr * da * 1.05);
						grad.addColorStop(0, "rgba(82,224,245,0.18)");
						grad.addColorStop(1, "rgba(82,224,245,0.02)");
						ctx.globalAlpha = alpha * 0.9;
						ctx.beginPath();
						for (let t = 0; t <= TAU + 1e-6; t += 0.04) {
							const p = ellPt(t);
							t === 0 ? ctx.moveTo(p.x, p.y) : ctx.lineTo(p.x, p.y);
						}
						ctx.closePath();
						ctx.fillStyle = grad;
						ctx.fill();
						// 元の円は薄い輪郭線で残す（倍率の比較対象）
						ctx.globalAlpha = alpha * 0.5;
						ctx.beginPath();
						ctx.arc(dcx, dcy, dr, 0, TAU);
						ctx.strokeStyle = "rgba(238,242,246,0.25)";
						ctx.lineWidth = 1;
						ctx.stroke();
					});

					const thousand = textShape("1000+", {
						width: w,
						height: h,
						fontPx: Math.min(w * 0.22, 300),
						centerY: h * 0.44,
					});
					const up = upwardScatter(PARTICLE_COUNT, w, h);
					return alignSets([scatter, diary, green, gauss, clt, det, thousand, up]);
				}

				function ensureSets() {
					const w = window.innerWidth;
					const h = window.innerHeight;
					const key = `${w}x${h}`;
					if (key !== builtKey) {
						sets = buildSets(w, h);
						builtKey = key;
						engine.setParticleCount(sets[0].length);
					}
				}

				const engine = new ParticleEngine(canvas, {
					dprMax: isMobile ? 1 : 1.5,
					mouseRepel: isMobile ? false : { radius: 120, strength: 5 },
				});
				if (!engine.reducedMotion && !isMobile) {
					engine.enableMouseTracking();
				}
				ensureSets();

				const c1 = document.getElementById("c1");
				const c2 = document.getElementById("c2");
				const c3 = document.getElementById("c3");
				const c4 = document.getElementById("c4");
				const c5 = document.getElementById("c5");
				const c6 = document.getElementById("c6");
				const c7 = document.getElementById("c7");
				const scn = document.getElementById("scn");
				const prog = document.getElementById("prog");
				const cur = document.getElementById("cur");
				const curdot = document.getElementById("curdot");
				let cx = 0;
				let cy = 0;

				function fade(p: number, a: number, b: number): number {
					// #248: ランプ幅は進捗 p の割合で効くため、#track を伸ばすと
					// 実スクロール距離でフェードが間延びする。#63 当時の約 28vh に
					// 近づけるため 0.05 → 0.028（1250vh で約 35vh）に詰める。
					const fi = Math.min(Math.max((p - a) / 0.028, 0), 1);
					const fo = Math.min(Math.max((b - p) / 0.028, 0), 1);
					return Math.min(fi, fo);
				}

				function applyCaption(el: HTMLElement | null, opacity: number) {
					if (!el) return;
					el.style.opacity = String(opacity);
					el.style.transform = `translateY(${(1 - opacity) * 26}px)`;
					if (el.id === "c7") el.style.pointerEvents = opacity > 0.5 ? "auto" : "none";
				}

				let currentP = 0;

				function getScrollProgress(): number {
					if (!track) return 0;
					const r = track.getBoundingClientRect();
					const denom = r.height - window.innerHeight;
					if (denom <= 0) return 1;
					return Math.min(Math.max(-r.top / denom, 0), 1);
				}

				engine.start(
					(i) => {
						if (engine.reducedMotion) {
							// 静止形: Diary の文字形（セット 1）で止める。
							return sets[1][i];
						}
						const { from, to, t } = segmentProgress(currentP, SEGMENTS);
						return lerpPoint(sets[from][i], sets[to][i], t);
					},
					(frame) => {
						if (engine.reducedMotion) return;

						ensureSets();
						currentP = getScrollProgress();
						const { from, to, t } = segmentProgress(currentP, SEGMENTS);

						// 各図形セットが支配的な間だけ、その塗り（fills）を重ねる。
						for (const [setIdx, fill] of fills) {
							let weight = 0;
							if (from === setIdx && to === setIdx) weight = 1;
							else if (to === setIdx) weight = t;
							else if (from === setIdx) weight = 1 - t;
							if (weight > 0.02) {
								const ctx = frame.ctx;
								ctx.save();
								fill(ctx, weight);
								ctx.restore();
							}
						}

						// #248: 各図形の静止区間の中心で全不透明になるように合わせる。
						applyCaption(c1, fade(currentP, -1, 0.075));
						applyCaption(c2, fade(currentP, 0.165, 0.3));
						applyCaption(c3, fade(currentP, 0.315, 0.45));
						applyCaption(c4, fade(currentP, 0.465, 0.6));
						applyCaption(c5, fade(currentP, 0.615, 0.75));
						applyCaption(c6, fade(currentP, 0.765, 0.878));
						applyCaption(c7, currentP > 0.895 ? Math.min((currentP - 0.895) / 0.035, 1) : 0);

						if (scn) {
							const n =
								currentP < 0.12
									? 1
									: currentP < 0.28
										? 2
										: currentP < 0.43
											? 3
											: currentP < 0.58
												? 4
												: currentP < 0.73
													? 5
													: currentP < 0.86
														? 6
														: 7;
							const txt = `0${n} / 07`;
							if (scn.textContent !== txt) scn.textContent = txt;
						}
						if (prog) prog.style.transform = `scaleY(${currentP})`;

						if (cur && curdot && !isMobile) {
							cx += (frame.mouse.x - cx) * 0.14;
							cy += (frame.mouse.y - cy) * 0.14;
							cur.style.transform = `translate(${cx - 17}px,${cy - 17}px)`;
							curdot.style.transform = `translate(${frame.mouse.x - 3}px,${frame.mouse.y - 3}px)`;
						}
					}
				);

				window.addEventListener("resize", () => {
					ensureSets();
				});
			}
		</script>
	</body>
</html>
