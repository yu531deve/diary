---
// 問題ページ /problems/{id}/（#26、design/02-B デザイン刷新は #66）。
//
// dist/html/{id}/problem.html（LaTeXML 出力）の本文を取り込んで表示する。
// - 数式: LaTeXML の出力は Presentation MathML（<math>...</math>）なので、
//   まずブラウザネイティブの MathML 描画を採用する。KaTeX は本来 TeX
//   ソースを直接レンダリングするライブラリで、MathML を経由するには
//   再パースが必要になり複雑さの割に得るものが小さい。主要ブラウザ
//   （Chrome 109+ / Firefox / Safari）は Presentation MathML の
//   ネイティブ描画に対応済みのため、まずこちらを採用し、表示品質が
//   不足する場合に限り KaTeX 等への切り替えを検討する（詳細は PR 本文）。
// - 図: dist/html/{id}/fig-*.svg を [fig].svg.ts が配信する。design/02-B の
//   右カラム「図パネル」に埋め込む（<img>。canvas 再実装はしない）。
// - フォールバック: <meta name="diary-fallback"> があれば PDF 埋め込み
//   表示に切り替える。
//
// design/02-B（design/README.md 「B. 問題ページ」節）準拠。
// 前後ナビは #61 の listPublishedProblems()（id 昇順）から算出する。
// 数値のハードコード禁止（design/README.md 実装時の注意 6）: PROBLEMS 数・
// 難易度ラベル等はすべて実データ（meta.yaml / docs/difficulty.md）に基づく。
//
// 関連問題セクション（#109）: computeRelatedProblems（site-data.ts）で
// ビルド時に静的算出する。実行時 fetch は行わない。選定ロジック・
// 「関連なしならセクション非表示」の担保はそちら側のコメント参照。
import {
  listPublishedProblems,
  readProblemHtml,
  hasProblemPdf,
  hasSolutionPdf,
  DistNotFoundError,
  type ProblemMeta,
} from "../../../lib/dist-content";
import {
  computeRelatedProblems,
  fieldSlugByMajor,
  type RelatedProblem,
} from "../../../lib/site-data";
import { formatMathTitle } from "../../../lib/title";
import SiteHead from "../../../components/SiteHead.astro";

export async function getStaticPaths() {
  const problems = listPublishedProblems();
  return problems.map((meta, i) => ({
    params: { id: meta.id },
    props: {
      meta,
      prev: i > 0 ? problems[i - 1] : null,
      next: i < problems.length - 1 ? problems[i + 1] : null,
      related: computeRelatedProblems(meta, problems),
    },
  }));
}

type Props = {
  meta: ProblemMeta;
  prev: ProblemMeta | null;
  next: ProblemMeta | null;
  related: RelatedProblem[];
};
const { meta, prev, next, related } = Astro.props;

let problemHtml;
try {
  problemHtml = readProblemHtml(meta.id);
} catch (e) {
  if (e instanceof DistNotFoundError) {
    throw new Error(
      `[problems/${meta.id}] ${e.message}\n` +
        "（site のビルド前にリポジトリルートで `make pdf && make html` を実行してください）"
    );
  }
  throw e;
}

const pdfAvailable = hasProblemPdf(meta.id);
const solutionPdfAvailable = hasSolutionPdf(meta.id);
const pdfHref = `/problems/${meta.id}/problem.pdf`;
const solutionPdfHref = `/solutions/${meta.id}/solution.pdf`;
const solutionHref = `/solutions/${meta.id}/`;
// #92: URL を大分野名（日本語）ではなく fields.yaml の slug ベースにする。
// 対応する slug が見つからない場合（辞書との不整合。lint で弾かれる想定）は
// フォールバックとして従来どおり大分野名を使う。
// 注: /fields/{slug}/ ページ自体は未実装で、このリンクは現状 404 のまま
// （#115 で対応予定）。今回はリンクの組み立てを slug ベースに直すのみ。
const fieldHref = `/fields/${fieldSlugByMajor(meta.field.major) ?? encodeURIComponent(meta.field.major)}/`;
// #227: meta.yaml の title は LaTeX（\diarytitle 用）が正。HTML 表示・
// issue タイトル・検索インデックス等では formatMathTitle で `$`・LaTeX
// コマンドを読める平文に落としてから使う（styles/diary.sty・meta.yaml
// のスキーマ自体は変更しない）。
const displayTitle = formatMathTitle(meta.title);
const issueHref = `https://github.com/yu531deve/diary/issues/new?title=${encodeURIComponent(
  `誤植報告: ${meta.id} ${displayTitle}`
)}`;

// docs/difficulty.md の 5 段階（数値のみが仕様。文言ラベルは定義されて
// いないため、実データの数値をそのまま出す）。
const difficultyNum = Number(meta.difficulty) || 0;
const difficultyDots = Array.from({ length: 5 }, (_, i) => i < difficultyNum);

// #71: Pagefind の全文検索対象は「地の文」のみで、数式は仕様外
// （site/CLAUDE.md「検索対象への数式の追加」禁止）。LaTeXML の出力は
// MathML（<math>...</math>、annotation として元の LaTeX ソースも
// 埋め込まれている。#150）なので、Pagefind の索引対象から丸ごと外すため
// data-pagefind-ignore="all" を各 <math> 要素に付与してから
// set:html する。属性の追加だけで表示（見た目）には影響しない。
const searchableBodyHtml = problemHtml.bodyHtml.replace(
  /<math\b/g,
  '<math data-pagefind-ignore="all"'
);

// LaTeXML 出力（problem.tex 内の figure）は本文に <img> をそのまま含む。
// design/02-B の図パネルは dist/html/{id}/fig-*.svg を独立表示する仕様の
// ため、本文側の重複表示を避けたい。ただし figureFiles が空の問題では
// パネル自体を「図なし」表示にフォールバックする。
const firstFigure = problemHtml.figureFiles[0] ?? null;
const figHref = firstFigure ? `/problems/${meta.id}/${firstFigure.replace(/\.svg$/i, "")}.svg` : null;

const formatDate = (d: string) => (d ? d.replaceAll("-", ".") : "—");

// #122: og:description（および新設の meta description）。分野・難易度を
// 含める（#106 子issue の元 issue 本文の指示）。displayTitle は既に
// formatMathTitle 済みなので $ 等は出ない。
const ogDescription = `${meta.field.major} / 難易度${difficultyNum || "—"} — ${meta.id} ${displayTitle}。理工系大学院入試の自作数学問題。`;
---

<html lang="ja">
	<head>
		<SiteHead
			title={`${meta.id} ${displayTitle} | Diary`}
			description={ogDescription}
			ogType="article"
		/>
		<style>
			:root {
				color-scheme: dark;
			}
			* {
				box-sizing: border-box;
			}
			body {
				margin: 0;
				background: #05060a;
				color: #dfe6ee;
				font-family: "Noto Sans JP", system-ui, sans-serif;
				-webkit-font-smoothing: antialiased;
			}
			a {
				color: inherit;
				text-decoration: none;
			}
			.mono {
				font-family: "IBM Plex Mono", monospace;
			}
			.math-fallback {
				font-family: "STIX Two Text", serif;
			}

			/* ヘッダー */
			.site-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 22px 48px;
				border-bottom: 1px solid rgba(255, 255, 255, 0.07);
			}
			.logo {
				display: flex;
				align-items: baseline;
				gap: 12px;
			}
			.logo strong {
				font: 700 19px "Space Grotesk", sans-serif;
			}
			.logo span {
				font: 400 10px "IBM Plex Mono", monospace;
				color: #768190;
				letter-spacing: 0.18em;
			}
			.header-nav {
				display: flex;
				align-items: center;
				gap: 30px;
				font-size: 13px;
				color: #aeb6c2;
			}

			/* パンくず */
			.breadcrumb {
				display: flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 10px;
				padding: 18px 48px;
				font: 400 11px "IBM Plex Mono", monospace;
				color: #768190;
				letter-spacing: 0.1em;
				border-bottom: 1px solid rgba(255, 255, 255, 0.06);
			}
			.breadcrumb a:hover {
				color: #52e0f5;
			}
			.breadcrumb .sep {
				color: #2a3340;
			}
			.breadcrumb .current {
				color: #dfe6ee;
			}

			/* 本体グリッド */
			.problem-grid {
				display: grid;
				grid-template-columns: 1fr 400px;
				gap: 64px;
				padding: 56px 48px 40px;
			}
			.col-main {
				display: flex;
				flex-direction: column;
				gap: 30px;
				min-width: 0;
			}
			.id-line {
				display: flex;
				align-items: center;
				gap: 18px;
				flex-wrap: wrap;
			}
			.problem-id {
				font: 500 34px "IBM Plex Mono", monospace;
				color: #52e0f5;
				letter-spacing: 0.02em;
			}
			.difficulty {
				display: flex;
				gap: 5px;
				align-items: center;
			}
			.difficulty .dot {
				width: 7px;
				height: 7px;
				border-radius: 50%;
				background: #2a3340;
			}
			.difficulty .dot.on {
				background: #52e0f5;
			}
			.difficulty .label {
				font: 400 11px "IBM Plex Mono", monospace;
				color: #768190;
				margin-left: 8px;
				letter-spacing: 0.1em;
			}
			.title-heading {
				margin: 0;
				font-size: 46px;
				font-weight: 900;
				line-height: 1.3;
				letter-spacing: 0.01em;
				text-wrap: pretty;
			}
			.tag-row {
				display: flex;
				gap: 8px;
				flex-wrap: wrap;
			}
			.tag-pill {
				padding: 6px 14px;
				border: 1px solid rgba(255, 255, 255, 0.14);
				border-radius: 999px;
				font-size: 11px;
				color: #aeb6c2;
			}
			.rule {
				height: 1px;
				background: rgba(255, 255, 255, 0.1);
			}
			.problem-body {
				max-width: 660px;
				font-size: 18px;
				line-height: 2.1;
				color: #dfe6ee;
			}
			.problem-body :global(p),
			.problem-body :global(.ltx_p) {
				margin: 0 0 22px;
				overflow-wrap: break-word;
			}
			.problem-body :global(ol),
			.problem-body :global(.ltx_enumerate) {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 18px;
			}
			.problem-body :global(.ltx_enumerate .ltx_item) {
				display: flex;
				gap: 18px;
				align-items: flex-start;
			}
			.problem-body :global(.ltx_tag) {
				font: 400 15px "IBM Plex Mono", monospace;
				color: #52e0f5;
				padding-top: 5px;
				flex-shrink: 0;
			}
			.problem-body :global(img) {
				max-width: 100%;
				height: auto;
				display: block;
				margin: 1rem auto;
			}
			/* 図は右カラムの図パネルに一本化する（design/02-B）。
			   本文中の <img class="diary-figure"> は重複表示になるため隠す
			   （scripts/tikz-svg.js が焼き込むクラス名）。 */
			.problem-body :global(img.diary-figure) {
				display: none;
			}
			.problem-body :global(math) {
				max-width: 100%;
				font-family: "STIX Two Text", serif;
			}
			/* 長い数式は折り返さず横スクロールに逃がす（モバイル崩れ対策） */
			.problem-body :global(.ltx_Math) {
				display: inline-block;
				max-width: 100%;
				overflow-x: auto;
				vertical-align: middle;
				font-family: "STIX Two Text", serif;
			}

			.solution-cta {
				display: flex;
				align-items: center;
				gap: 14px;
				padding: 26px 30px;
				border: 1px solid rgba(82, 224, 245, 0.28);
				background: rgba(82, 224, 245, 0.05);
				max-width: 660px;
				flex-wrap: wrap;
			}
			.solution-cta .copy {
				display: flex;
				flex-direction: column;
				gap: 5px;
				flex: 1;
				min-width: 200px;
			}
			.solution-cta .label {
				font: 500 11px "IBM Plex Mono", monospace;
				letter-spacing: 0.2em;
				color: #52e0f5;
			}
			.solution-cta .desc {
				font-size: 14px;
				color: #aeb6c2;
			}
			.solution-cta .cta-btn {
				padding: 14px 28px;
				background: #52e0f5;
				color: #06232a;
				font-weight: 700;
				font-size: 14px;
				border-radius: 2px;
				white-space: nowrap;
			}
			.solution-cta .cta-btn:hover {
				background: #7ce8f8;
			}

			/* 右カラム */
			.col-side {
				display: flex;
				flex-direction: column;
				gap: 24px;
				min-width: 0;
			}
			.figure-panel {
				border: 1px solid rgba(255, 255, 255, 0.1);
				background: #080a10;
			}
			.figure-panel .fig-header {
				display: flex;
				justify-content: space-between;
				gap: 12px;
				padding: 12px 16px;
				border-bottom: 1px solid rgba(255, 255, 255, 0.08);
				font: 400 10px "IBM Plex Mono", monospace;
				color: #768190;
				letter-spacing: 0.16em;
			}
			.figure-panel .fig-body {
				display: flex;
				align-items: center;
				justify-content: center;
				width: 100%;
				height: 320px;
				padding: 16px;
			}
			.figure-panel .fig-body img {
				max-width: 100%;
				max-height: 100%;
				/* #82 の暫定対応（CSS フィルタでの白黒反転 + 色相回転）は
				   #83 でビルド時の SVG 色変換（scripts/tikz-svg.js の
				   transformSvgColorsForWeb）に置き換えたため撤去した。
				   dist/{id}/fig-*.svg は生成時点で既にダークテーマ配色
				   （既定線を rgba(226,236,244,.85) 相当に、強調点の赤を
				   明るい赤に変換）になっている。PDF 側の SVG は元の黒線の
				   まま（scripts/build-pdf.js は別経路のため影響を受けない）。 */
			}
			.figure-panel .fig-empty {
				font-size: 12px;
				color: #6d7a8f;
			}

			.pdf-links {
				display: flex;
				flex-direction: column;
				gap: 1px;
				background: rgba(255, 255, 255, 0.1);
				border: 1px solid rgba(255, 255, 255, 0.1);
			}
			.pdf-links a {
				display: flex;
				align-items: center;
				gap: 14px;
				padding: 18px 20px;
				background: #05060a;
				transition: background 0.2s;
			}
			.pdf-links a:hover {
				background: #0c0f16;
			}
			.pdf-links .pdf-badge {
				font: 400 10px "IBM Plex Mono", monospace;
				color: #52e0f5;
				letter-spacing: 0.14em;
			}
			.pdf-links .pdf-name {
				font-size: 14px;
				font-weight: 500;
			}
			.pdf-links .arrow {
				margin-left: auto;
				color: #768190;
			}

			.meta-info {
				display: flex;
				flex-direction: column;
				gap: 14px;
				font: 400 12px "IBM Plex Mono", monospace;
				color: #768190;
			}
			.meta-info .row {
				display: flex;
				justify-content: space-between;
			}
			.meta-info .row .k {
				letter-spacing: 0.14em;
			}
			.meta-info .row .v {
				color: #aeb6c2;
			}

			.report-link {
				font-size: 12px;
				color: #768190;
				border-bottom: 1px solid rgba(255, 255, 255, 0.12);
				padding-bottom: 6px;
				align-self: flex-start;
			}
			.report-link:hover {
				color: #aeb6c2;
			}

			/* フォールバック通知（デザイントーンに合わせる） */
			.fallback-notice {
				max-width: 660px;
				padding: 18px 22px;
				border: 1px solid rgba(82, 224, 245, 0.28);
				background: rgba(82, 224, 245, 0.05);
				border-radius: 0;
				margin-bottom: 8px;
				font-size: 14px;
				line-height: 1.8;
				color: #aeb6c2;
			}
			.fallback-notice strong {
				color: #52e0f5;
				font-weight: 700;
			}
			.fallback-embed {
				width: 100%;
				max-width: 660px;
				height: 80vh;
				border: 1px solid rgba(255, 255, 255, 0.1);
				background: #fff;
			}

			/* 関連問題（#109） */
			.related-section {
				padding: 40px 48px;
				border-top: 1px solid rgba(255, 255, 255, 0.09);
			}
			.related-heading {
				margin: 0 0 20px;
				font: 400 11px "IBM Plex Mono", monospace;
				letter-spacing: 0.18em;
				color: #52e0f5;
			}
			.related-list {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
				gap: 1px;
				background: rgba(255, 255, 255, 0.1);
				border: 1px solid rgba(255, 255, 255, 0.1);
			}
			.related-card {
				display: flex;
				flex-direction: column;
				gap: 8px;
				padding: 18px 20px;
				background: #05060a;
				transition: background 0.2s;
			}
			.related-card:hover {
				background: #0c0f16;
			}
			.related-card .related-id {
				font: 500 12px "IBM Plex Mono", monospace;
				color: #52e0f5;
				letter-spacing: 0.04em;
			}
			.related-card .related-title {
				font-size: 14px;
				font-weight: 500;
				line-height: 1.5;
			}
			.related-card .related-field {
				font: 400 11px "IBM Plex Mono", monospace;
				color: #768190;
				letter-spacing: 0.04em;
			}
			@media (max-width: 900px) {
				.related-section {
					padding: 32px 24px;
				}
			}

			/* 前後ナビ */
			.pager {
				display: flex;
				border-top: 1px solid rgba(255, 255, 255, 0.09);
				flex-wrap: wrap;
			}
			.pager a,
			.pager .disabled {
				flex: 1 1 260px;
				display: flex;
				flex-direction: column;
				gap: 8px;
				padding: 28px 48px;
				min-width: 0;
			}
			.pager a:first-child,
			.pager .disabled:first-child {
				border-right: 1px solid rgba(255, 255, 255, 0.09);
			}
			.pager a:last-child,
			.pager .disabled:last-child {
				align-items: flex-end;
				text-align: right;
			}
			.pager a:hover {
				background: #0c0f16;
			}
			.pager .dir-label {
				font: 400 10px "IBM Plex Mono", monospace;
				color: #768190;
				letter-spacing: 0.16em;
			}
			.pager a .dir-label {
				color: #52e0f5;
			}
			.pager .pager-title {
				font-size: 16px;
				font-weight: 500;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
				max-width: 100%;
			}
			.pager .disabled .pager-title {
				color: #6d7a8f;
			}

			@media (max-width: 900px) {
				.site-header,
				.breadcrumb {
					padding-left: 24px;
					padding-right: 24px;
				}
				.header-nav span:not(:last-child) {
					display: none;
				}
				.problem-grid {
					grid-template-columns: 1fr;
					gap: 40px;
					padding: 32px 24px;
				}
				.title-heading {
					font-size: 32px;
				}
				.problem-body {
					font-size: 16px;
					line-height: 1.95;
				}
				.pager a:first-child,
				.pager .disabled:first-child {
					border-right: none;
					border-bottom: 1px solid rgba(255, 255, 255, 0.09);
				}
				.pager a:last-child,
				.pager .disabled:last-child {
					align-items: flex-start;
					text-align: left;
				}
			}
			@media (max-width: 480px) {
				.problem-id {
					font-size: 26px;
				}
				.title-heading {
					font-size: 26px;
				}
				.solution-cta {
					flex-direction: column;
					align-items: stretch;
				}
				.solution-cta .cta-btn {
					text-align: center;
				}
				.fallback-embed {
					height: 60vh;
				}
			}

			/* ---------- モバイル固定アクションバー(design/03_mobile.dc.html M問題) ---------- */
			.mobile-action-bar {
				display: none;
			}
			@media (max-width: 860px) {
				.mobile-action-bar {
					position: fixed;
					left: 0;
					right: 0;
					bottom: 0;
					z-index: 200;
					display: flex;
					gap: 10px;
					padding: 14px 24px calc(22px + env(safe-area-inset-bottom, 0px));
					background: rgba(5, 6, 10, 0.96);
					border-top: 1px solid rgba(255, 255, 255, 0.1);
					-webkit-backdrop-filter: blur(12px);
					backdrop-filter: blur(12px);
				}
				.mobile-action-bar .solve-btn {
					flex: 1;
					display: flex;
					align-items: center;
					justify-content: center;
					height: 52px;
					background: #52e0f5;
					color: #06232a;
					font-weight: 700;
					font-size: 14px;
					border-radius: 3px;
				}
				.mobile-action-bar .pdf-btn,
				.mobile-action-bar .save-btn {
					width: 52px;
					height: 52px;
					display: flex;
					align-items: center;
					justify-content: center;
					border: 1px solid rgba(255, 255, 255, 0.2);
					border-radius: 3px;
					color: #aeb6c2;
					background: none;
					font-family: inherit;
					cursor: pointer;
				}
				.mobile-action-bar .pdf-btn {
					font: 400 10px "IBM Plex Mono", monospace;
				}
				.mobile-action-bar .save-btn {
					font-size: 16px;
				}
				.mobile-action-bar .save-btn.is-saved {
					color: #52e0f5;
					border-color: rgba(82, 224, 245, 0.5);
				}
				.mobile-action-bar .save-btn:disabled {
					opacity: 0.35;
					cursor: not-allowed;
				}
				/* アクションバー分、本文末尾が隠れないように余白を足す */
				body {
					padding-bottom: 96px;
				}
			}
		</style>
	</head>
	<body>
		<header class="site-header">
			<a class="logo" href="/">
				<strong>Diary</strong>
				<span>SELF-MADE MATHEMATICS</span>
			</a>
			<nav class="header-nav">
				<a href="/fields/">分野</a>
				<a href="/">新着</a>
				<a href="/archive/">アーカイブ</a>
			</nav>
		</header>

		<nav class="breadcrumb" aria-label="パンくずリスト">
			<a href="/">HOME</a>
			<span class="sep">/</span>
			<a href={fieldHref}>{meta.field.major}</a>
			<span class="sep">/</span>
			<span class="current">{meta.field.minor}</span>
			<span class="sep">/</span>
			<span class="current">{meta.id}</span>
		</nav>

		<!--
			#71: ⌘K 検索(Pagefind)の索引対象をこの <main> 配下だけに絞る。
			data-pagefind-body はサイト内のどこか 1 箇所にでも付けると、
			Pagefind はこの属性を持つページ・要素以外を丸ごと索引から除外する
			仕様（ヘッダー・ナビ等の定型文の重複ヒットを避けつつ、解答ページ
			・トップ・分野一覧・/dev/ 配下などは data-pagefind-body を
			一切付けていないためこの実装だけで自動的に索引対象外になる）。
			id / タイトル / タグ / 地の文が対象で、数式は searchableBodyHtml
			側で data-pagefind-ignore="all" により除外している。
		-->
		<main data-pagefind-body>
		<div class="problem-grid">
			<div class="col-main">
				<div>
					<div class="id-line">
						<span class="problem-id" data-pagefind-meta={`id:${meta.id}`}>{meta.id}</span>
						<span class="difficulty" data-pagefind-meta={`difficulty:${meta.difficulty}`}>
							{difficultyDots.map((on) => <span class={`dot${on ? " on" : ""}`} />)}
							<span class="label">難易度 {difficultyNum || "—"} / 5</span>
						</span>
					</div>
					<h1 class="title-heading" data-pagefind-meta="title">{displayTitle}</h1>
				</div>

				<div class="tag-row">
					<span
						class="tag-pill"
						data-pagefind-filter={`field:${meta.field.major}`}
						data-pagefind-meta={`field:${meta.field.major}`}
					>
						{meta.field.major}
					</span>
					<span class="tag-pill" data-pagefind-meta={`sub:${meta.field.minor}`}>
						{meta.field.minor}
					</span>
					{meta.tags.map((t) => (
						<span class="tag-pill" data-pagefind-filter={`tag:${t}`}>{t}</span>
					))}
				</div>

				<div class="rule" />

				{
					problemHtml.isFallback ? (
						<div class="fallback-notice">
							<strong>この問題は HTML への自動変換に失敗したため、PDF を埋め込み表示しています。</strong>
							{problemHtml.fallbackReason && <>（理由: {problemHtml.fallbackReason}）</>}
						</div>
					) : null
				}

				{
					problemHtml.isFallback ? (
						pdfAvailable ? (
							<embed class="fallback-embed" src={pdfHref} type="application/pdf" />
						) : (
							<p>PDF も見つかりませんでした。ビルドを確認してください。</p>
						)
					) : (
						<div class="problem-body" set:html={searchableBodyHtml} />
					)
				}

				<div class="solution-cta">
					<div class="copy">
						<span class="label">SOLUTION</span>
						<span class="desc">解いたあとに。ヒントから段階的に開けます。</span>
					</div>
					<a class="cta-btn" href={solutionHref}>解答ページへ →</a>
				</div>
			</div>

			<div class="col-side">
				<div class="figure-panel">
					<div class="fig-header">
						<span>FIGURE</span>
					</div>
					<div class="fig-body">
						{
							figHref ? (
								<img src={figHref} alt={`${meta.id} の図`} />
							) : (
								<span class="fig-empty">この問題に図はありません</span>
							)
						}
					</div>
				</div>

				<div class="pdf-links">
					{
						pdfAvailable && (
							<a href={pdfHref} download>
								<span class="pdf-badge">PDF</span>
								<span class="pdf-name">問題（印刷用）</span>
								<span class="arrow">↓</span>
							</a>
						)
					}
					{
						solutionPdfAvailable && (
							<a href={solutionPdfHref} download>
								<span class="pdf-badge">PDF</span>
								<span class="pdf-name">解答（印刷用）</span>
								<span class="arrow">↓</span>
							</a>
						)
					}
				</div>

				<div class="meta-info">
					<div class="row">
						<span class="k">CREATED</span>
						<span class="v">{formatDate(meta.created)}</span>
					</div>
					<div class="row">
						<span class="k">UPDATED</span>
						<span class="v">{formatDate(meta.updated)}</span>
					</div>
					<div class="row">
						<span class="k">LICENSE</span>
						<span class="v">個人利用のみ</span>
					</div>
				</div>

				<a class="report-link" href={issueHref} target="_blank" rel="noopener noreferrer">
					誤植・不備を報告する → GitHub Issue
				</a>
			</div>
		</div>

		{
			related.length > 0 && (
				<section class="related-section" aria-label="関連問題">
					<h2 class="related-heading">RELATED PROBLEMS</h2>
					<div class="related-list">
						{related.map((r) => (
							<a class="related-card" href={`/problems/${r.id}/`}>
								<span class="related-id">{r.id}</span>
								<span class="related-title">{formatMathTitle(r.title)}</span>
								<span class="related-field">
									{r.field.major} / {r.field.minor}
								</span>
							</a>
						))}
					</div>
				</section>
			)
		}

		<div class="pager">
			{
				prev ? (
					<a href={`/problems/${prev.id}/`}>
						<span class="dir-label">← PREV / {prev.id}</span>
						<span class="pager-title">{formatMathTitle(prev.title)}</span>
					</a>
				) : (
					<div class="disabled">
						<span class="dir-label">← PREV</span>
						<span class="pager-title">最初の問題です</span>
					</div>
				)
			}
			{
				next ? (
					<a href={`/problems/${next.id}/`}>
						<span class="dir-label">NEXT / {next.id} →</span>
						<span class="pager-title">{formatMathTitle(next.title)}</span>
					</a>
				) : (
					<div class="disabled">
						<span class="dir-label">NEXT →</span>
						<span class="pager-title">最新の問題です</span>
					</div>
				)
			}
		</div>

		<div class="mobile-action-bar">
			<a class="solve-btn" href={solutionHref}>解答を見る</a>
			{
				pdfAvailable && (
					<a class="pdf-btn" href={pdfHref} download aria-label="問題PDFをダウンロード">PDF</a>
				)
			}
			<button
				type="button"
				class="save-btn"
				id="mobile-save-btn"
				data-problem-id={meta.id}
				aria-pressed="false"
				aria-label="この問題を保存"
				disabled
			>
				☆
			</button>
		</div>
		</main>

		<script>
			// issue #152: 横スクロールする数式（.ltx_Math）にキーボードフォーカスを
			// 通す。実際にスクロールが発生している要素にだけ tabindex を振る
			// （全数式に振るとタブ移動が過剰になるため）。
			import { markScrollableMath } from "../../../lib/scrollable-math";

			const applyScrollableMath = () => {
				markScrollableMath(document, ".problem-body .ltx_Math");
			};
			applyScrollableMath();
			window.addEventListener("resize", applyScrollableMath);

			// issue #69: 保存(☆)ボタン。localStorage 任意機能（lib/save-store.ts）。
			// localStorage が使えない環境では isStorageAvailable() が false を返し、
			// ボタンは disabled のまま（マークアップ側の既定値）で、他の機能
			// （解答を見る・PDF）には一切影響しない。
			import { isStorageAvailable, isSaved, toggleSaved } from "../../../lib/save-store";

			const btn = document.getElementById("mobile-save-btn") as HTMLButtonElement | null;
			if (btn) {
				const id = btn.dataset.problemId ?? "";
				if (id && isStorageAvailable()) {
					btn.disabled = false;
					const sync = () => {
						const saved = isSaved(id);
						btn.classList.toggle("is-saved", saved);
						btn.setAttribute("aria-pressed", saved ? "true" : "false");
						btn.textContent = saved ? "★" : "☆";
					};
					sync();
					btn.addEventListener("click", () => {
						toggleSaved(id);
						sync();
					});
				}
			}
		</script>
	</body>
</html>
