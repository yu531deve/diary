---
// 問題ページ /problems/{id}/（#26）。
//
// dist/html/{id}/problem.html（LaTeXML 出力）の本文を取り込んで表示する。
// - 数式: LaTeXML の出力は Presentation MathML（<math>...</math>）なので、
//   まずブラウザネイティブの MathML 描画を採用する。KaTeX は本来 TeX
//   ソースを直接レンダリングするライブラリで、MathML を経由するには
//   再パースが必要になり複雑さの割に得るものが小さい。主要ブラウザ
//   （Chrome 109+ / Firefox / Safari）は Presentation MathML の
//   ネイティブ描画に対応済みのため、まずこちらを採用し、表示品質が
//   不足する場合に限り KaTeX 等への切り替えを検討する（詳細は PR 本文）。
// - 図: dist/html/{id}/fig-*.svg を astro.config.mjs の
//   astro:build:done フックでビルド出力にコピーし、<img src="fig-n.svg">
//   をそのまま解決させる。
// - フォールバック: <meta name="diary-fallback"> があれば PDF 埋め込み
//   表示に切り替える。
import {
  listPublishedProblems,
  readProblemHtml,
  hasProblemPdf,
  DistNotFoundError,
  type ProblemMeta,
} from "../../../lib/dist-content";

export async function getStaticPaths() {
  const problems = listPublishedProblems();
  return problems.map((meta) => ({
    params: { id: meta.id },
    props: { meta },
  }));
}

type Props = { meta: ProblemMeta };
const { meta } = Astro.props;

let problemHtml;
try {
  problemHtml = readProblemHtml(meta.id);
} catch (e) {
  if (e instanceof DistNotFoundError) {
    throw new Error(
      `[problems/${meta.id}] ${e.message}\n` +
        "（site のビルド前にリポジトリルートで `make pdf && make html` を実行してください）"
    );
  }
  throw e;
}

const pdfAvailable = hasProblemPdf(meta.id);
const pdfHref = `/problems/${meta.id}/problem.pdf`;
const solutionHref = `/solutions/${meta.id}/`;
const issueHref = `https://github.com/yu531deve/diary/issues/new?title=${encodeURIComponent(
  `誤植報告: ${meta.id} ${meta.title}`
)}`;
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{meta.title} | Diary</title>
		<style>
			:root {
				color-scheme: light dark;
				font-family: system-ui, sans-serif;
			}
			* {
				box-sizing: border-box;
			}
			body {
				max-width: 42rem;
				margin: 0 auto;
				padding: 1.5rem;
				line-height: 1.7;
				overflow-x: hidden;
			}
			header.page-header h1 {
				font-size: 1.4rem;
				margin-bottom: 0.25rem;
			}
			.meta-line {
				font-size: 0.85rem;
				opacity: 0.75;
				margin: 0 0 1rem;
			}
			.meta-line span {
				margin-right: 0.75rem;
				display: inline-block;
			}
			nav.actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin: 1.25rem 0;
			}
			nav.actions a {
				display: inline-block;
				padding: 0.5rem 0.9rem;
				border: 1px solid currentColor;
				border-radius: 0.4rem;
				text-decoration: none;
				color: inherit;
				font-size: 0.9rem;
			}
			nav.actions a.primary {
				font-weight: bold;
			}
			.problem-body {
				border-top: 1px solid color-mix(in srgb, currentColor 20%, transparent);
				padding-top: 1.25rem;
			}
			.problem-body :global(p),
			.problem-body :global(.ltx_p) {
				margin: 0 0 1rem;
				overflow-wrap: break-word;
			}
			.problem-body :global(ol),
			.problem-body :global(.ltx_enumerate) {
				padding-left: 1.4rem;
			}
			.problem-body :global(img) {
				max-width: 100%;
				height: auto;
				display: block;
				margin: 1rem auto;
			}
			.problem-body :global(math) {
				max-width: 100%;
			}
			/* 長い数式は折り返さず横スクロールに逃がす（モバイル崩れ対策） */
			.problem-body :global(.ltx_Math) {
				display: inline-block;
				max-width: 100%;
				overflow-x: auto;
				vertical-align: middle;
			}
			.fallback-notice {
				padding: 0.75rem 1rem;
				background: color-mix(in srgb, orange 18%, transparent);
				border: 1px solid color-mix(in srgb, orange 45%, transparent);
				border-radius: 0.4rem;
				margin-bottom: 1rem;
				font-size: 0.9rem;
			}
			.fallback-embed {
				width: 100%;
				height: 80vh;
				border: 1px solid color-mix(in srgb, currentColor 25%, transparent);
			}
			@media (max-width: 480px) {
				body {
					padding: 1rem;
				}
				nav.actions a {
					flex: 1 1 auto;
					text-align: center;
				}
				.fallback-embed {
					height: 60vh;
				}
			}
		</style>
	</head>
	<body>
		<p><a href="/">← 一覧に戻る</a></p>
		<header class="page-header">
			<h1>{meta.id} {meta.title}</h1>
			<p class="meta-line">
				<span>分野: {meta.field.major} / {meta.field.minor}</span>
				{meta.difficulty && <span>難易度: {meta.difficulty}</span>}
				{meta.tags.length > 0 && <span>タグ: {meta.tags.join("、")}</span>}
			</p>
		</header>

		<nav class="actions">
			{
				pdfAvailable && (
					<a class="primary" href={pdfHref} download>
						問題 PDF をダウンロード
					</a>
				)
			}
			<a class="primary" href={solutionHref}>
				解答を見る
			</a>
			<a href={issueHref} target="_blank" rel="noopener noreferrer">
				誤植を報告する
			</a>
		</nav>

		{
			problemHtml.isFallback ? (
				<div class="fallback-notice">
					この問題は HTML への自動変換に失敗したため、PDF を埋め込み表示しています。
					{problemHtml.fallbackReason && (
						<>（理由: {problemHtml.fallbackReason}）</>
					)}
				</div>
			) : null
		}

		{
			problemHtml.isFallback ? (
				pdfAvailable ? (
					<embed
						class="fallback-embed"
						src={pdfHref}
						type="application/pdf"
					/>
				) : (
					<p>PDF も見つかりませんでした。ビルドを確認してください。</p>
				)
			) : (
				<div class="problem-body" set:html={problemHtml.bodyHtml} />
			)
		}
	</body>
</html>
