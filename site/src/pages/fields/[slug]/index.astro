---
// 分野別詳細ページ /fields/{slug}/（#115）。
//
// #92 で fields.yaml が slug 付きリスト構造に刷新され、問題ページの分野
// リンク（site/src/pages/problems/[id]/index.astro）や /fields/ 索引の
// 中分野ピルは `/fields/{slug}/` を指すようになったが、このルート自体が
// 存在しなかったため 404 になっていた（#115 本体）。
//
// getStaticPaths で fields.yaml の全 slug 分のページを静的生成する。
// 問題 0 件の分野でもページを生成し、空状態を表示する（#115 の要求）。
//
// レイアウト・CSS トークンは /fields/ index.astro・/archive/ index.astro
// に揃える（新しいスタイル体系を作らない、という依頼どおり）。下層ページ
// のため装飾アニメ・重い JS は禁止（site/CLAUDE.md）。中分野の絞り込みは
// ページ内フィルタ（表示/非表示の切り替えのみ、アニメーションなし）で行う。
import { parseFieldsTree } from "../../../lib/site-data";
import { listPublishedProblems } from "../../../lib/dist-content";
import type { ProblemMeta } from "../../../lib/dist-content";
import SearchModal from "../../../components/SearchModal.astro";
import BottomTabNav from "../../../components/BottomTabNav.astro";

export async function getStaticPaths() {
  const tree = parseFieldsTree();
  const problems = listPublishedProblems();

  return tree.map((entry) => {
    const fieldProblems = problems.filter((p) => p.field.major === entry.major);
    return {
      params: { slug: entry.slug },
      props: {
        entry,
        problems: fieldProblems,
      },
    };
  });
}

type Props = {
  entry: { slug: string; major: string; minors: string[] };
  problems: ProblemMeta[];
};
const { entry, problems } = Astro.props;

// 公開日の新しい順（archive/index.astro と同じ並び順規約）。
const sorted = [...problems].sort((a, b) => {
  if (a.created !== b.created) {
    if (!a.created) return 1;
    if (!b.created) return -1;
    return a.created < b.created ? 1 : -1;
  }
  return a.id < b.id ? 1 : -1;
});

// 実際に問題が存在する中分野のみを絞り込みピルとして出す。
// fields.yaml に定義があっても該当問題が無い中分野はピル自体を出さない
// （押しても結果が空になるだけの導線を避けるため）。
const minorCounts = new Map<string, number>();
for (const p of sorted) {
  if (!p.field.minor) continue;
  minorCounts.set(p.field.minor, (minorCounts.get(p.field.minor) ?? 0) + 1);
}
const minorsWithProblems = entry.minors.filter((m) => minorCounts.has(m));

function difficultyDots(difficulty: string): boolean[] {
  const n = Math.max(0, Math.min(5, parseInt(difficulty, 10) || 0));
  return Array.from({ length: 5 }, (_, i) => i < n);
}

function formatDate(d: string): string {
  return d ? d.replaceAll("-", ".") : "日付未設定";
}
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{entry.major} — 分野から探す | Diary</title>
		<meta
			name="description"
			content={`${entry.major}の理工系大学院入試向け自作数学問題を一覧できます。`}
		/>
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&family=Noto+Serif+JP:wght@400;600;700&family=IBM+Plex+Mono:wght@400;500&family=STIX+Two+Text:ital,wght@0,400;0,700;1,400;1,700&family=Space+Grotesk:wght@500;700&display=swap"
		/>
		<style>
			:root {
				color-scheme: dark;
			}
			* {
				box-sizing: border-box;
			}
			html,
			body {
				margin: 0;
				background: #05060a;
				color: #eef2f6;
				font-family:
					"Noto Sans JP",
					system-ui,
					sans-serif;
			}
			a {
				color: inherit;
				text-decoration: none;
			}
			::selection {
				background: #52e0f5;
				color: #05060a;
			}

			.page {
				max-width: 1080px;
				margin: 0 auto;
				padding-bottom: 96px;
			}

			/* ヘッダー */
			.site-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 22px 48px;
				border-bottom: 1px solid rgba(255, 255, 255, 0.07);
			}
			.site-header .brand {
				display: flex;
				align-items: baseline;
				gap: 12px;
			}
			.site-header .brand .logo {
				font: 700 19px "Space Grotesk", sans-serif;
			}
			.site-header .brand .tagline {
				font: 400 10px "IBM Plex Mono", monospace;
				color: #5c6572;
				letter-spacing: 0.18em;
			}
			.site-nav {
				display: flex;
				align-items: center;
				gap: 30px;
				font-size: 13px;
				color: #aeb6c2;
			}
			.site-nav a.active {
				color: #52e0f5;
			}
			.site-nav .search-chip {
				display: flex;
				align-items: center;
				gap: 8px;
				padding: 7px 14px;
				border: 1px solid rgba(255, 255, 255, 0.14);
				border-radius: 999px;
				font: 400 11px "IBM Plex Mono", monospace;
				color: #7d8794;
			}
			.site-nav .search-chip kbd {
				color: #4a5361;
				font: inherit;
			}

			/* パンくず */
			.breadcrumb {
				display: flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 10px;
				padding: 18px 48px;
				font: 400 11px "IBM Plex Mono", monospace;
				color: #5c6572;
				letter-spacing: 0.1em;
				border-bottom: 1px solid rgba(255, 255, 255, 0.06);
			}
			.breadcrumb a:hover {
				color: #52e0f5;
			}
			.breadcrumb .sep {
				color: #2a3340;
			}
			.breadcrumb .current {
				color: #dfe6ee;
			}

			/* ヒーロー */
			.hero {
				display: flex;
				align-items: flex-end;
				justify-content: space-between;
				gap: 24px;
				padding: 48px 48px 34px;
				flex-wrap: wrap;
			}
			.hero-copy {
				display: flex;
				flex-direction: column;
				gap: 16px;
			}
			.hero-copy .label {
				font: 500 11px "IBM Plex Mono", monospace;
				letter-spacing: 0.3em;
				color: #52e0f5;
			}
			.hero-copy h1 {
				margin: 0;
				font-size: 52px;
				font-weight: 900;
				line-height: 1.15;
				letter-spacing: 0.01em;
				text-wrap: pretty;
			}
			.hero-stats {
				display: flex;
				gap: 34px;
				font: 400 11px "IBM Plex Mono", monospace;
				color: #5c6572;
				letter-spacing: 0.12em;
				padding-bottom: 8px;
			}
			.hero-stats strong {
				color: #dfe6ee;
				font-weight: 500;
			}

			/* 中分野フィルタ */
			.minor-filter {
				display: flex;
				flex-wrap: wrap;
				gap: 10px;
				padding: 0 48px 34px;
			}
			.minor-filter button {
				display: flex;
				align-items: baseline;
				gap: 8px;
				padding: 9px 16px;
				border: 1px solid rgba(255, 255, 255, 0.14);
				border-radius: 999px;
				font: inherit;
				font-size: 13px;
				color: #c3ccd8;
				background: none;
				cursor: pointer;
			}
			.minor-filter button:hover {
				border-color: #52e0f5;
				color: #52e0f5;
			}
			.minor-filter button.is-active {
				border-color: #52e0f5;
				color: #52e0f5;
				background: rgba(82, 224, 245, 0.08);
			}
			.minor-filter .minor-count {
				font: 400 10px "IBM Plex Mono", monospace;
				color: #5c6572;
			}

			/* 問題一覧 */
			.problem-list {
				padding: 0 48px 70px;
				display: flex;
				flex-direction: column;
			}
			.problem-row {
				display: flex;
				align-items: center;
				gap: 24px;
				padding: 16px 0;
				border-top: 1px solid rgba(255, 255, 255, 0.06);
				transition: padding-left 0.2s;
			}
			.problem-list .problem-row:last-child {
				border-bottom: 1px solid rgba(255, 255, 255, 0.06);
			}
			.problem-row:hover {
				padding-left: 10px;
			}
			.problem-row.is-hidden {
				display: none;
			}
			.problem-row .id {
				font: 400 12px "IBM Plex Mono", monospace;
				color: #4a5361;
				width: 44px;
				flex-shrink: 0;
			}
			.problem-row .title {
				font-size: 15px;
				color: #eef2f6;
				flex: 1 1 auto;
				min-width: 0;
			}
			.problem-row:hover .title {
				color: #52e0f5;
			}
			.problem-row .pill {
				font: 400 11px "IBM Plex Mono", monospace;
				color: #7d8794;
				border: 1px solid rgba(255, 255, 255, 0.12);
				border-radius: 999px;
				padding: 4px 10px;
				white-space: nowrap;
				flex-shrink: 0;
			}
			.problem-row .dots {
				display: flex;
				gap: 3px;
				flex-shrink: 0;
			}
			.problem-row .dots span {
				width: 6px;
				height: 6px;
				border-radius: 50%;
				background: #2a3340;
			}
			.problem-row .dots span.on {
				background: #52e0f5;
			}
			.problem-row .date {
				font: 400 11px "IBM Plex Mono", monospace;
				color: #5c6572;
				width: 78px;
				text-align: right;
				flex-shrink: 0;
			}

			.empty-note {
				padding: 0 48px 70px;
				color: #7d8794;
				font-size: 14px;
			}

			@media (max-width: 720px) {
				.site-header,
				.breadcrumb {
					padding-left: 24px;
					padding-right: 24px;
				}
				.site-nav {
					gap: 16px;
					font-size: 12px;
				}
				.site-nav .search-chip span:not(.sr-only) {
					display: none;
				}
				.hero {
					padding: 32px 24px 24px;
					align-items: flex-start;
				}
				.hero-copy h1 {
					font-size: 30px;
					line-height: 1.2;
				}
				.hero-stats {
					gap: 18px;
					padding-bottom: 0;
				}
				.minor-filter {
					padding: 0 24px 24px;
				}
				.problem-list {
					padding: 0 24px 96px;
				}
				.empty-note {
					padding: 0 24px 96px;
				}
				.problem-row {
					flex-wrap: wrap;
					gap: 8px 14px;
					padding: 14px 0;
				}
				.problem-row .id {
					width: auto;
				}
				.problem-row .title {
					flex-basis: 100%;
					order: 1;
				}
				.problem-row .date {
					width: auto;
					text-align: left;
				}
			}
		</style>
	</head>
	<body>
		<div class="page">
			<header class="site-header">
				<div class="brand">
					<a href="/" style="display:flex;align-items:baseline;gap:12px;">
						<span class="logo">Diary</span>
						<span class="tagline">SELF-MADE MATHEMATICS</span>
					</a>
				</div>
				<nav class="site-nav">
					<a href="/fields/" class="active">分野</a>
					<a href="/">新着</a>
					<a href="/archive/">アーカイブ</a>
					<span class="search-chip" data-search-open
						>検索<kbd>⌘K</kbd></span
					>
				</nav>
			</header>

			<SearchModal />

			<nav class="breadcrumb" aria-label="パンくずリスト">
				<a href="/">HOME</a>
				<span class="sep">/</span>
				<a href="/fields/">FIELDS</a>
				<span class="sep">/</span>
				<span class="current">{entry.major}</span>
			</nav>

			<section class="hero">
				<div class="hero-copy">
					<span class="label">FIELD</span>
					<h1>{entry.major}</h1>
				</div>
				<div class="hero-stats">
					<span>PROBLEMS <strong>{String(sorted.length).padStart(4, "0")}</strong></span>
				</div>
			</section>

			{
				minorsWithProblems.length > 0 && (
					<div class="minor-filter" id="minor-filter" role="group" aria-label="中分野で絞り込み">
						<button type="button" class="is-active" data-minor="">
							すべて<span class="minor-count">{sorted.length}</span>
						</button>
						{minorsWithProblems.map((m) => (
							<button type="button" data-minor={m}>
								{m}
								<span class="minor-count">{minorCounts.get(m) ?? 0}</span>
							</button>
						))}
					</div>
				)
			}

			{
				sorted.length === 0 ? (
					<p class="empty-note">この分野にはまだ公開された問題がありません。</p>
				) : (
					<div class="problem-list" id="problem-list">
						{sorted.map((p) => (
							<a href={`/problems/${p.id}/`} class="problem-row" data-minor={p.field.minor}>
								<span class="id">{p.id}</span>
								<span class="title">{p.title}</span>
								<span class="pill">{p.field.minor}</span>
								<span class="dots">
									{difficultyDots(p.difficulty).map((on) => (
										<span class:list={[{ on }]} />
									))}
								</span>
								<span class="date">{formatDate(p.created)}</span>
							</a>
						))}
					</div>
				)
			}
		</div>

		<BottomTabNav active="fields" />

		<script>
			// 中分野フィルタ。ページ遷移なしの表示/非表示切り替えのみ
			// （装飾アニメ・重い JS は下層ページで禁止のため、それ以上は行わない）。
			const filter = document.getElementById("minor-filter");
			const list = document.getElementById("problem-list");
			if (filter && list) {
				const buttons = Array.from(filter.querySelectorAll<HTMLButtonElement>("button"));
				const rows = Array.from(list.querySelectorAll<HTMLElement>(".problem-row"));
				for (const btn of buttons) {
					btn.addEventListener("click", () => {
						for (const other of buttons) other.classList.remove("is-active");
						btn.classList.add("is-active");
						const minor = btn.dataset.minor ?? "";
						for (const row of rows) {
							const show = minor === "" || row.dataset.minor === minor;
							row.classList.toggle("is-hidden", !show);
						}
					});
				}
			}
		</script>
	</body>
</html>
