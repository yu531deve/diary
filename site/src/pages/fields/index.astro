---
// 分野別索引 /fields/（#65）。design/02_desktop_screens.dc.html の A 画面
// （分野別索引）と design/03_mobile.dc.html の「M 索引」を Astro + 素の
// HTML/CSS/JS に書き直したもの。support.js ランタイムは移植せず、DOM 構造・
// スタイル値・単一開閉アコーディオンのロジックだけを読み取って再実装している。
//
// このページはヘッダー等の共有コンポーネントを新設せず、ページ内に閉じた
// 実装にしている（#66 と並行作業中のため、全ページ共通化は行わない）。
// ただし ⌘K 検索モーダル（#70）のみ site/src/components/SearchModal.astro
// を共有コンポーネントとして差し込む（依頼どおり）。
//
// 数値のハードコード禁止（design/README.md 実装時の注意 6）。分野名・
// 問題数はすべて site-data.ts 経由で content/ と fields.yaml から算出する。
import { computeFieldIndex, computeSiteStats } from "../../lib/site-data";
import { listPublishedProblems } from "../../lib/dist-content";
import SearchModal from "../../components/SearchModal.astro";
import BottomTabNav from "../../components/BottomTabNav.astro";

const fieldIndex = computeFieldIndex();
const stats = computeSiteStats();
const problems = listPublishedProblems();

// 中分野ピルのリンク先: 「当面はその分野の問題ページへの直リンクで可」
// （issue #65 補足）。該当分野の published 問題のうち先頭 1 件の
// /problems/{id}/ を割り当てる。該当問題が無い場合はリンク無効（span）。
function firstProblemUrl(major: string, minor: string): string | null {
  const hit = problems.find(
    (p) => p.field.major === major && p.field.minor === minor,
  );
  return hit ? `/problems/${hit.id}/` : null;
}

// 初期展開分野: 問題数が最多の大分野（design の固定値 '13' 相当を
// 実データから動的に算出）。全 0 件なら何も開かない。
const initialOpenMajor = fieldIndex.reduce<string | null>((best, f) => {
  if (f.count <= 0) return best;
  if (best === null) return f.major;
  const bestCount = fieldIndex.find((x) => x.major === best)?.count ?? 0;
  return f.count > bestCount ? f.major : best;
}, null);

const fieldsForClient = fieldIndex.map((f) => ({
  major: f.major,
  slug: f.slug,
  count: f.count,
  minors: f.minors.map((m) => ({
    name: m.name,
    count: m.count,
    href: firstProblemUrl(f.major, m.name),
  })),
}));
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>分野から探す — Diary</title>
		<meta
			name="description"
			content="理工系大学院入試の自作数学問題を大分野・中分野から探せます。"
		/>
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&family=Noto+Serif+JP:wght@400;600;700&family=IBM+Plex+Mono:wght@400;500&family=STIX+Two+Text:ital,wght@0,400;0,700;1,400;1,700&family=Space+Grotesk:wght@500;700&display=swap"
		/>
		<style>
			:root {
				color-scheme: dark;
			}
			* {
				box-sizing: border-box;
			}
			html,
			body {
				margin: 0;
				background: #05060a;
				color: #eef2f6;
				font-family:
					"Noto Sans JP",
					system-ui,
					sans-serif;
			}
			a {
				color: inherit;
				text-decoration: none;
			}
			::selection {
				background: #52e0f5;
				color: #05060a;
			}

			.page {
				max-width: 1440px;
				margin: 0 auto;
			}

			/* ヘッダー */
			.site-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 22px 48px;
				border-bottom: 1px solid rgba(255, 255, 255, 0.07);
			}
			.site-header .brand {
				display: flex;
				align-items: baseline;
				gap: 12px;
			}
			.site-header .brand .logo {
				font: 700 19px "Space Grotesk", sans-serif;
			}
			.site-header .brand .tagline {
				font: 400 10px "IBM Plex Mono", monospace;
				color: #5c6572;
				letter-spacing: 0.18em;
			}
			.site-nav {
				display: flex;
				align-items: center;
				gap: 30px;
				font-size: 13px;
				color: #aeb6c2;
			}
			.site-nav a.active {
				color: #52e0f5;
			}
			.site-nav .search-chip {
				display: flex;
				align-items: center;
				gap: 8px;
				padding: 7px 14px;
				border: 1px solid rgba(255, 255, 255, 0.14);
				border-radius: 999px;
				font: 400 11px "IBM Plex Mono", monospace;
				color: #7d8794;
			}
			.site-nav .search-chip kbd {
				color: #4a5361;
				font: inherit;
			}

			/* ヒーロー */
			.hero {
				display: flex;
				align-items: flex-end;
				justify-content: space-between;
				gap: 24px;
				padding: 64px 48px 34px;
				flex-wrap: wrap;
			}
			.hero-copy {
				display: flex;
				flex-direction: column;
				gap: 16px;
			}
			.hero-copy .label {
				font: 500 11px "IBM Plex Mono", monospace;
				letter-spacing: 0.3em;
				color: #52e0f5;
			}
			.hero-copy h1 {
				margin: 0;
				font-size: 76px;
				font-weight: 900;
				line-height: 1;
				letter-spacing: 0.01em;
				text-wrap: pretty;
			}
			.hero-copy p {
				margin: 0;
				font-size: 14px;
				line-height: 1.9;
				color: #7d8794;
			}
			.hero-stats {
				display: flex;
				gap: 34px;
				font: 400 11px "IBM Plex Mono", monospace;
				color: #5c6572;
				letter-spacing: 0.12em;
				padding-bottom: 8px;
			}
			.hero-stats strong {
				color: #dfe6ee;
				font-weight: 500;
			}

			/* アコーディオン */
			.field-list {
				padding: 0 48px 70px;
				display: flex;
				flex-direction: column;
			}
			.field-row {
				border-top: 1px solid rgba(255, 255, 255, 0.1);
			}
			.field-row:last-child {
				border-bottom: 1px solid rgba(255, 255, 255, 0.1);
			}
			.field-row-head {
				display: flex;
				align-items: center;
				gap: 34px;
				padding: 24px 0;
				width: 100%;
			}
			.field-row-link {
				display: flex;
				align-items: center;
				gap: 34px;
				flex: 1 1 auto;
				min-width: 0;
				transition: padding-left .25s;
			}
			.field-row-link:hover {
				padding-left: 22px;
			}
			.field-toggle {
				display: flex;
				align-items: center;
				margin-left: auto;
				flex-shrink: 0;
				background: none;
				border: none;
				font-family: inherit;
				cursor: pointer;
				padding: 0;
			}
			.field-row.is-empty .field-toggle {
				cursor: default;
			}
			.field-no {
				font: 400 12px "IBM Plex Mono", monospace;
				color: #4a5361;
				width: 34px;
				flex-shrink: 0;
			}
			.field-name {
				font-size: 44px;
				font-weight: 900;
				letter-spacing: 0.02em;
				line-height: 1.15;
				color: #eef2f6;
			}
			.field-row.is-open .field-name {
				color: #52e0f5;
			}
			.field-row.is-empty .field-name {
				color: #4a5361;
			}
			.field-meta {
				display: flex;
				align-items: center;
				gap: 26px;
				flex-shrink: 0;
			}
			.field-count {
				font: 400 12px "IBM Plex Mono", monospace;
				color: #5c6572;
			}
			.field-sign {
				font: 400 18px "IBM Plex Mono", monospace;
				color: #52e0f5;
				width: 14px;
				text-align: center;
			}
			.field-row.is-empty .field-sign {
				color: #2a3340;
			}

			.field-panel {
				overflow: hidden;
				max-height: 0;
				opacity: 0;
				transition:
					max-height 0.4s ease,
					opacity 0.3s;
			}
			.field-row.is-open .field-panel {
				max-height: 200px;
				opacity: 1;
			}
			.field-subs {
				display: flex;
				flex-wrap: wrap;
				gap: 10px;
				padding: 0 0 26px 68px;
			}
			.field-sub {
				display: flex;
				align-items: baseline;
				gap: 10px;
				padding: 9px 16px;
				border: 1px solid rgba(255, 255, 255, 0.14);
				border-radius: 999px;
				font-size: 13px;
				color: #c3ccd8;
				transition: all 0.2s;
			}
			a.field-sub:hover {
				border-color: #52e0f5;
				color: #52e0f5;
			}
			.field-sub.is-disabled {
				color: #5c6572;
				cursor: default;
			}
			.field-sub-count {
				font: 400 10px "IBM Plex Mono", monospace;
				color: #5c6572;
			}

			@media (max-width: 720px) {
				.site-header {
					padding: 16px 24px;
				}
				.site-nav {
					gap: 16px;
					font-size: 12px;
				}
				.site-nav .search-chip span:not(.sr-only) {
					display: none;
				}
				.hero {
					padding: 40px 24px 24px;
					align-items: flex-start;
				}
				.hero-copy h1 {
					font-size: 34px;
					line-height: 1.2;
				}
				.hero-stats {
					gap: 18px;
					padding-bottom: 0;
				}
				.field-list {
					padding: 0 24px 96px;
				}
				.field-row-head {
					padding: 17px 0;
				}
				.field-row-link {
					gap: 14px;
				}
				.field-row-link:hover {
					padding-left: 0;
				}
				.field-no {
					font-size: 10px;
					width: 20px;
				}
				.field-name {
					font-size: 20px;
					font-weight: 700;
					line-height: 1.3;
				}
				.field-meta {
					gap: 14px;
				}
				.field-row.is-open .field-panel {
					max-height: 260px;
				}
				.field-subs {
					padding: 0 0 18px 34px;
					gap: 8px;
				}
				.field-sub {
					padding: 9px 14px;
					font-size: 12px;
				}
			}
		</style>
	</head>
	<body>
		<div class="page">
			<header class="site-header">
				<div class="brand">
					<span class="logo">Diary</span>
					<span class="tagline">SELF-MADE MATHEMATICS</span>
				</div>
				<nav class="site-nav">
					<a href="/fields/" class="active">分野</a>
					<a href="/">新着</a>
					<span class="search-chip" data-search-open
						>検索<kbd>⌘K</kbd></span
					>
				</nav>
			</header>

			<SearchModal />

			<section class="hero">
				<div class="hero-copy">
					<span class="label">FIELDS</span>
					<h1>分野から探す</h1>
					<p>大分野をクリックすると中分野が展開します。すべての問題は完全自作。</p>
				</div>
				<div class="hero-stats">
					<span>FIELDS <strong>{stats.fieldCount}</strong></span>
					<span>PROBLEMS <strong>{String(stats.problemCount).padStart(4, "0")}</strong></span>
				</div>
			</section>

			<div class="field-list" id="field-list">
				{
					fieldsForClient.map((f, i) => {
						const isEmpty = f.count === 0;
						const isOpen = !isEmpty && f.major === initialOpenMajor;
						return (
							<div
								class={`field-row${isOpen ? " is-open" : ""}${isEmpty ? " is-empty" : ""}`}
								data-major={f.major}
							>
								<div class="field-row-head">
									<a class="field-row-link" href={`/fields/${f.slug}/`}>
										<span class="field-no">{String(i + 1).padStart(2, "0")}</span>
										<span class="field-name">{f.major}</span>
									</a>
									<button
										class="field-toggle"
										type="button"
										aria-expanded={isOpen ? "true" : "false"}
										aria-label="中分野の一覧を開閉"
										disabled={isEmpty}
									>
										<span class="field-meta">
											<span class="field-count">{f.count} 問</span>
											<span class="field-sign">{isOpen ? "−" : "+"}</span>
										</span>
									</button>
								</div>
								<div class="field-panel">
									<div class="field-subs">
										{f.minors.map((m) =>
											m.href ? (
												<a class="field-sub" href={m.href}>
													{m.name}
													<span class="field-sub-count">{m.count}</span>
												</a>
											) : (
												<span class="field-sub is-disabled">
													{m.name}
													<span class="field-sub-count">{m.count}</span>
												</span>
											),
										)}
									</div>
								</div>
							</div>
						);
					})
				}
			</div>
		</div>

		<BottomTabNav active="fields" />

		<script>
			// 単一開閉アコーディオン。design/README.md「分野アコーディオン」仕様
			// （max-height + opacity, .4s ease）どおり、開いた分野は1つだけ。
			// 問題 0 件の分野（.is-empty）はクリック無効（ボタンを disabled にしている）。
			const list = document.getElementById("field-list");
			if (list) {
				const rows = Array.from(
					list.querySelectorAll<HTMLElement>(".field-row:not(.is-empty)"),
				);
				for (const row of rows) {
					const head = row.querySelector<HTMLButtonElement>(".field-toggle");
					const sign = row.querySelector<HTMLElement>(".field-sign");
					if (!head || !sign) continue;
					head.addEventListener("click", () => {
						const willOpen = !row.classList.contains("is-open");
						for (const other of rows) {
							if (other === row) continue;
							other.classList.remove("is-open");
							other.querySelector(".field-toggle")?.setAttribute(
								"aria-expanded",
								"false",
							);
							const otherSign = other.querySelector(".field-sign");
							if (otherSign) otherSign.textContent = "+";
						}
						row.classList.toggle("is-open", willOpen);
						head.setAttribute("aria-expanded", willOpen ? "true" : "false");
						sign.textContent = willOpen ? "−" : "+";
					});
				}
			}
		</script>
	</body>
</html>
