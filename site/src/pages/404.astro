---
// 404 ページ(#104)。既存の /fields/ /about/ と同じ「ページ内に閉じた
// 実装」方針(ヘッダー・配色・フォントトークンをそのまま複製)に揃えている。
// 共通レイアウトコンポーネントは未整備のため新設せず、既存ページから
// スタイル値を読み取って再利用した。
//
// 下層ページなので site/CLAUDE.md の原則どおり、装飾アニメ・重い JS は
// 使わない(許可されるのは hover 程度の軽量トランジションのみ)。
// ⌘K 検索モーダルのみ他ページと同様に共有コンポーネントとして差し込む。
import SearchModal from "../components/SearchModal.astro";
import BottomTabNav from "../components/BottomTabNav.astro";
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>ページが見つかりません — Diary</title>
		<meta name="robots" content="noindex" />
		<meta
			name="description"
			content="お探しのページは見つかりませんでした。"
		/>
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400&family=IBM+Plex+Mono:wght@400;500&family=Space+Grotesk:wght@700;900&display=swap"
		/>
		<style>
			:root {
				color-scheme: dark;
			}
			* {
				box-sizing: border-box;
			}
			html,
			body {
				margin: 0;
				background: #05060a;
				color: #eef2f6;
				font-family:
					"Noto Sans JP",
					system-ui,
					sans-serif;
				min-height: 100vh;
			}
			a {
				color: inherit;
				text-decoration: none;
			}
			::selection {
				background: #52e0f5;
				color: #05060a;
			}

			.page {
				max-width: 1440px;
				margin: 0 auto;
				min-height: 100vh;
				display: flex;
				flex-direction: column;
			}

			/* ヘッダー */
			.site-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 22px 48px;
				border-bottom: 1px solid rgba(255, 255, 255, 0.07);
			}
			.site-header .brand {
				display: flex;
				align-items: baseline;
				gap: 12px;
			}
			.site-header .brand .logo {
				font: 700 19px "Space Grotesk", sans-serif;
			}
			.site-header .brand .tagline {
				font: 400 10px "IBM Plex Mono", monospace;
				color: #768190;
				letter-spacing: 0.18em;
			}
			.site-nav {
				display: flex;
				align-items: center;
				gap: 30px;
				font-size: 13px;
				color: #aeb6c2;
			}
			.site-nav a:hover {
				color: #52e0f5;
			}
			.site-nav .search-chip {
				display: flex;
				align-items: center;
				gap: 8px;
				padding: 7px 14px;
				border: 1px solid rgba(255, 255, 255, 0.14);
				border-radius: 999px;
				font: 400 11px "IBM Plex Mono", monospace;
				color: #7d8794;
			}
			.site-nav .search-chip kbd {
				color: #6d7a8f;
				font: inherit;
			}

			/* 404 本体 */
			.not-found {
				flex: 1;
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				justify-content: center;
				gap: 20px;
				padding: 64px 48px 120px;
			}
			.not-found .label {
				font: 500 11px "IBM Plex Mono", monospace;
				letter-spacing: 0.3em;
				color: #52e0f5;
			}
			.not-found h1 {
				margin: 0;
				font: 900 120px "Space Grotesk", sans-serif;
				line-height: 1;
				letter-spacing: 0.01em;
				color: #eef2f6;
			}
			.not-found p {
				margin: 0;
				max-width: 520px;
				font-size: 15px;
				line-height: 1.9;
				color: #7d8794;
			}
			.not-found-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 14px;
				margin-top: 12px;
			}
			.not-found-actions a {
				display: inline-flex;
				align-items: center;
				gap: 10px;
				padding: 14px 24px;
				border: 1px solid rgba(255, 255, 255, 0.2);
				font-size: 13px;
				color: #dfe6ee;
				transition:
					border-color 0.2s,
					color 0.2s;
			}
			.not-found-actions a:hover {
				border-color: #52e0f5;
				color: #52e0f5;
			}
			.not-found-actions a.primary {
				border-color: #52e0f5;
				color: #52e0f5;
			}
			.not-found-actions a.primary:hover {
				background: rgba(82, 224, 245, 0.1);
			}

			@media (max-width: 720px) {
				.site-header {
					padding: 16px 24px;
				}
				.site-nav {
					gap: 16px;
					font-size: 12px;
				}
				.site-nav .search-chip span:not(.sr-only) {
					display: none;
				}
				.not-found {
					padding: 40px 24px 96px;
				}
				.not-found h1 {
					font-size: 64px;
				}
			}
		</style>
	</head>
	<body>
		<div class="page">
			<header class="site-header">
				<div class="brand">
					<span class="logo">Diary</span>
					<span class="tagline">SELF-MADE MATHEMATICS</span>
				</div>
				<nav class="site-nav">
					<a href="/fields/">分野</a>
					<a href="/">新着</a>
					<span class="search-chip" data-search-open
						>検索<kbd>⌘K</kbd></span
					>
				</nav>
			</header>

			<SearchModal />

			<section class="not-found">
				<span class="label">404</span>
				<h1>Not Found</h1>
				<p>
					お探しのページは見つかりませんでした。URL
					が誤っているか、問題が未公開・欠番の可能性があります。
				</p>
				<div class="not-found-actions">
					<a class="primary" href="/">トップへ戻る</a>
					<a href="/fields/">分野から探す</a>
				</div>
			</section>
		</div>

		<BottomTabNav active={null} />
	</body>
</html>
