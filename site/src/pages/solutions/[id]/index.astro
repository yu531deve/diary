---
// 解答ページ /solutions/{id}/（#27 で仮実装 → #67 で design/02-C の
// High-fidelity デザインに刷新）。URL は不変条件のため変更しない。
//
// 「解く前にうっかり答えが見えてしまう」のを防ぐ段階開示は
// design/README.md 「C. 解答ページ」節に準拠する:
//   STEP1 ヒント / STEP2 方針 = 折りたたみパネル
//   STEP3 解答           = 未開示時は DOM から除去（hidden 属性）+ オーバーレイ
// 開示状態は保存しない（sessionStorage 等に依存しない。site/CLAUDE.md 禁止）。
//
// 実装方式（#149 で JS 駆動に変更）:
//   - STEP1/STEP2 のアコーディオンは引き続きネイティブ <details>/<summary>
//     （grid-template-rows の 0fr↔1fr トリック、JS 不要）。
//   - STEP3 は当初チェックボックスハック（隠し <input type=checkbox> + <label> +
//     ~ 兄弟結合子）+ filter: blur() で実装していたが、#124 の a11y 監査（#149）で
//     「blur は視覚効果に過ぎず、未開示状態でも .answer-body の答え本文が
//     DOM 上にそのまま存在し、スクリーンリーダー・リーダーモード・テキスト選択で
//     読めてしまう」不具合が発覚した。
//     同じページの ANSWER カード（462 行目付近のコメント参照、#67 起因）は
//     既に「未開示状態で答えの実体を DOM 上に一切出さない」方式
//     （revealed 側を hidden にしておき、開示時だけ表示に切り替える）で
//     対応済みだったため、.answer-body もそれに合わせる。
//     具体的には .answer-body は初期状態で `hidden` 属性付き・空の div とし、
//     答え本文（HTML）はサーバー側で base64 エンコードした上で
//     <script type="application/octet-stream"> に埋め込む（この type は
//     ブラウザに実行されず、内容はアクセシビリティツリーにも露出しない）。
//     ANSWER カードは display:none による既存方式のままで統一を保っている。
//     hidden 属性だけでも読み上げ・選択・視覚表示は防げるが、それだけだと
//     ビルド成果物の HTML ソースには答えの文章がそのまま残ってしまうため
//     （#149 の受け入れ条件は「ビルド後の index.html を grep して答え本文が
//     含まれないこと」を明示的に求めている）、base64 化までを一手ずつ行う。
//     「解答を表示する」ボタン（<button aria-expanded aria-controls>）
//     クリック時に最小限の JS でデコードして .answer-body に挿入し、
//     hidden を外す。
//   - site/CLAUDE.md は「検索と解答表示トグル以外で重い JS を入れない」と
//     定めており、解答表示トグルへの JS 使用はそもそも許容されている。
//     追加した JS は開示ボタンのクリックハンドラ 1 つのみで、ロジックは
//     base64 デコード・hidden 属性のトグル・aria-expanded の同期・
//     ANSWER カードの placeholder/revealed 切り替えだけの数十行に留めている。
//   - JS が無効な環境では base64 データをデコードする手段が無いため、答えは
//     「常に非表示」側に倒れる（要求どおり、露出はしない）。<noscript> で
//     その旨を明示するメッセージを表示する。
//
// STEP1/STEP2 の原稿:
//   content/{id}/ には現時点で hint.tex・policy.tex の規約が無く
//   （content/CLAUDE.md 参照）、scripts/build-html.js も problem/solution
//   の 2 種類しかビルドしない。dist-content.ts の readHintHtml/readPolicyHtml
//   は「無ければ null」を返す設計にしてあるため、原稿が無い問題（現状すべて、
//   0001 含む）では自動的に STEP1/STEP2 が出ない。将来 hint.tex/policy.tex
//   の規約が追加された場合もこのページの変更なしで対応できる。
//
// 「答え」の視覚強調（border-left 2px #52e0f5）:
//   LaTeXML 出力には「これが答えである」という印が無いため、
//   markFinalAnswerEquations() が各設問（<li class="ltx_item">）内の
//   最後の表示数式をヒューリスティックに「答え」とみなしてクラスを付与する
//   （dist-content.ts 参照）。原稿の書き方に依存する近似である。
//
// design からの逸脱（#67 レビュー対応）:
//   design/README.md では右カラムの ANSWER カードに最終結果の数式
//   （例: S = 9/2）をそのまま表示する仕様だが、MathML 断片を機械的に
//   抽出して独立に再レンダリングする方式（extractFinalAnswerMath、
//   #67 初版で実装）は、抽出した断片が本文の該当式と意味的に完全一致
//   することを保証できず、実機検証で誤った見え方をする既知のリスクが
//   あった（レビュー指摘）。正確性を保証できない抽出結果を「答え」として
//   見せるのは解答ページの信頼性に関わるため、ANSWER カードには数式を
//   出さず、開示後は本文の答えブロックへのアンカーリンク（✓ 解答を見る）
//   に置き換える。未開示時は STEP3 と同様に「● ● ●」のみを表示する。
import {
  listPublishedProblems,
  readSolutionHtml,
  readHintHtml,
  readPolicyHtml,
  hasSolutionPdf,
  markFinalAnswerEquations,
  DistNotFoundError,
  type ProblemMeta,
} from "../../../lib/dist-content";
import { formatMathTitle } from "../../../lib/title";
import { difficultyNum as toDifficultyNum } from "../../../lib/difficulty";
import SiteHead from "../../../components/SiteHead.astro";
import DifficultyBadge from "../../../components/DifficultyBadge.astro";

export async function getStaticPaths() {
  const problems = listPublishedProblems();
  return problems.map((meta) => ({
    params: { id: meta.id },
    props: { meta, allProblems: problems },
  }));
}

type Props = { meta: ProblemMeta; allProblems: ProblemMeta[] };
const { meta, allProblems } = Astro.props;

let solutionHtml;
try {
  solutionHtml = readSolutionHtml(meta.id);
} catch (e) {
  if (e instanceof DistNotFoundError) {
    throw new Error(
      `[solutions/${meta.id}] ${e.message}\n` +
        "（site のビルド前にリポジトリルートで `make pdf && make html` を実行してください）"
    );
  }
  throw e;
}

const hintHtml = readHintHtml(meta.id);
const policyHtml = readPolicyHtml(meta.id);

const pdfAvailable = hasSolutionPdf(meta.id);
const pdfHref = `/solutions/${meta.id}/solution.pdf`;
const problemHref = `/problems/${meta.id}/`;
// #227: title は LaTeX（\diarytitle 用）が正のため formatMathTitle で
// 表示用平文に整形してから使う（problems/[id]/index.astro と同方針）。
const displayTitle = formatMathTitle(meta.title);
const issueHref = `https://github.com/yu531deve/diary/issues/new?title=${encodeURIComponent(
  `誤植報告: ${meta.id} ${displayTitle}（解答）`
)}`;

// #122: og:description（および新設の meta description）。分野・難易度を
// 含める（problems/[id]/index.astro と同方針）。
const ogDescription = `${meta.field.major} / 難易度${toDifficultyNum(meta.difficulty) || "—"} — ${meta.id} ${displayTitle} の解答。理工系大学院入試の自作数学問題。`;

const bodyHtml = solutionHtml.isFallback ? "" : markFinalAnswerEquations(solutionHtml.bodyHtml);
// ANSWER カードから本文の答えブロックへ飛ぶためのアンカー ID。
const answerAnchorId = `answer-body-${meta.id}`;
// #149: 答え本文を未開示状態の HTML に「答えとして読める形」で出さないため、
// <script type="application/octet-stream"> に base64 エンコードして埋め込み、
// 開示ボタンクリック時にのみ JS でデコードして .answer-body に挿入する。
// hidden 属性だけでも読み上げ・選択・視覚表示は防げるが、それだけだと
// ページのソース上には答えの文章がそのまま残ってしまう。base64 化することで
// view-source やビルド成果物の grep でも答えの文面が直接読めない状態にする。
const bodyHtmlEncoded = solutionHtml.isFallback
  ? ""
  : Buffer.from(bodyHtml, "utf-8").toString("base64");

// 関連問題: 同じ大分野（field.major）から、id 昇順で自分以外を最大 2 件。
const related = allProblems
  .filter((p) => p.id !== meta.id && p.field.major && p.field.major === meta.field.major)
  .sort((a, b) => (a.id < b.id ? -1 : a.id > b.id ? 1 : 0))
  .slice(0, 2);

const formatDate = (d: string) => (d ? d.replaceAll("-", ".") : "—");
---

<html lang="ja">
	<head>
		<SiteHead
			title={`解答 | ${meta.id} ${displayTitle} | Diary`}
			description={ogDescription}
			ogType="article"
			ogImage={`/problems/${meta.id}/og.png`}
		/>
		<style>
			:root {
				color-scheme: dark;
			}
			* {
				box-sizing: border-box;
			}
			body {
				margin: 0;
				background: #05060a;
				color: #dfe6ee;
				font-family: "Noto Sans JP", system-ui, sans-serif;
				-webkit-font-smoothing: antialiased;
				overflow-x: hidden;
			}
			a {
				color: inherit;
				text-decoration: none;
			}
			.mono {
				font-family: "IBM Plex Mono", monospace;
			}

			/* ヘッダー */
			.site-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 22px 48px;
				border-bottom: 1px solid rgba(255, 255, 255, 0.07);
			}
			.logo {
				display: flex;
				align-items: baseline;
				gap: 12px;
			}
			.logo strong {
				font: 700 19px "Space Grotesk", sans-serif;
			}
			.logo span {
				font: 400 10px "IBM Plex Mono", monospace;
				color: #768190;
				letter-spacing: 0.18em;
			}
			.back-link {
				font-size: 13px;
				color: #aeb6c2;
			}
			.back-link:hover {
				color: #52e0f5;
			}
			.header-links {
				display: flex;
				align-items: center;
				gap: 24px;
			}
			.header-links a {
				font-size: 13px;
				color: #aeb6c2;
			}
			.header-links a:hover {
				color: #52e0f5;
			}

			/* 本体グリッド */
			.solution-grid {
				display: grid;
				grid-template-columns: 1fr 300px;
				gap: 64px;
				padding: 52px 48px 60px;
			}
			.col-main {
				display: flex;
				flex-direction: column;
				gap: 28px;
				max-width: 720px;
				min-width: 0;
			}
			.head-block {
				display: flex;
				flex-direction: column;
				gap: 12px;
			}
			.eyebrow {
				font: 500 11px "IBM Plex Mono", monospace;
				letter-spacing: 0.3em;
				color: #52e0f5;
			}
			.title-heading {
				margin: 0;
				font-size: 38px;
				font-weight: 900;
				line-height: 1.35;
				letter-spacing: 0.01em;
				text-wrap: pretty;
			}
			.lede {
				margin: 0;
				font-size: 13px;
				color: #768190;
			}

			/* STEP パネル共通 */
			.step-panel {
				border: 1px solid rgba(255, 255, 255, 0.12);
				background: #080a10;
			}
			.step-panel > summary {
				display: flex;
				align-items: center;
				gap: 16px;
				padding: 20px 26px;
				cursor: pointer;
				list-style: none;
				transition: background 0.2s;
			}
			.step-panel > summary::-webkit-details-marker {
				display: none;
			}
			.step-panel > summary:hover {
				background: #0c0f16;
			}
			.step-panel .step-label {
				font: 400 10px "IBM Plex Mono", monospace;
				color: #52e0f5;
				letter-spacing: 0.18em;
			}
			.step-panel .step-title {
				font-size: 16px;
				font-weight: 700;
			}
			.step-panel .step-toggle {
				margin-left: auto;
				font: 400 12px "IBM Plex Mono", monospace;
				color: #768190;
			}
			.step-panel .step-toggle::before {
				content: "開く";
			}
			.step-panel[open] .step-toggle::before {
				content: "閉じる";
			}
			/* grid-template-rows 0fr↔1fr トリックで JS 無しの開閉アニメーション */
			.step-panel .step-body-wrap {
				display: grid;
				grid-template-rows: 0fr;
				transition: grid-template-rows 0.45s ease;
			}
			.step-panel[open] .step-body-wrap {
				grid-template-rows: 1fr;
			}
			.step-panel .step-body-inner {
				overflow: hidden;
			}
			.step-panel .step-body {
				margin: 0;
				padding: 0 26px 24px;
				font-size: 16px;
				line-height: 2;
				color: #c3ccd8;
			}
			.step-panel .step-body :global(math) {
				font-family: "STIX Two Text", serif;
			}

			/* STEP3 解答 */
			.answer-panel {
				position: relative;
				border: 1px solid rgba(82, 224, 245, 0.28);
				background: #080a10;
			}
			.answer-panel .step-head {
				display: flex;
				align-items: center;
				gap: 16px;
				padding: 20px 26px;
				border-bottom: 1px solid rgba(255, 255, 255, 0.08);
			}
			.answer-panel .step-head .step-toggle::before {
				content: "未表示";
			}
			.answer-panel.is-revealed .step-head .step-toggle::before {
				content: "表示中";
			}
			.answer-reveal-wrap {
				position: relative;
			}
			.answer-body {
				padding: 28px 26px 32px;
				display: flex;
				flex-direction: column;
				gap: 22px;
				filter: blur(9px);
				transition: filter 0.6s ease;
			}
			/* hidden 属性が付いている間は答え本文を DOM 上に見せない
			   （#149）。author スタイルは UA スタイルの [hidden]{display:none}
			   より優先されてしまうため、.answer-body 側の display:flex を
			   明示的に上書きする必要がある。 */
			.answer-body[hidden] {
				display: none;
			}
			.answer-body.is-revealed {
				filter: blur(0);
			}
			.answer-body :global(p),
			.answer-body :global(.ltx_p) {
				margin: 0;
				font-size: 16px;
				line-height: 2.05;
				color: #dfe6ee;
				overflow-wrap: break-word;
			}
			.answer-body :global(math),
			.step-body :global(math) {
				font-family: "STIX Two Text", serif;
			}
			/* インライン数式（ltx_Math）は個別に横スクロールへ逃がす。
			   横に長い式が段落中にあってもページ全体は横に伸びない
			   （problem ページ .problem-body :global(.ltx_Math) と同方針）。 */
			.answer-body :global(.ltx_Math),
			.step-body :global(.ltx_Math) {
				display: inline-block;
				max-width: 100%;
				overflow-x: auto;
				vertical-align: middle;
			}
			.answer-body :global(ol),
			.answer-body :global(.ltx_enumerate) {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 22px;
			}
			.answer-body :global(.ltx_enumerate > .ltx_item) {
				display: flex;
				flex-direction: column;
				gap: 12px;
			}
			.answer-body :global(.ltx_tag_item) {
				font: 400 12px "IBM Plex Mono", monospace;
				color: #52e0f5;
				letter-spacing: 0.16em;
			}
			.answer-body :global(.ltx_para) {
				display: flex;
				flex-direction: column;
				gap: 12px;
			}
			/* 表示数式（途中式） */
			.answer-body :global(table.ltx_equation) {
				display: block;
				width: 100%;
				max-width: 100%;
				overflow-x: auto;
				border-collapse: collapse;
				background: rgba(255, 255, 255, 0.03);
				padding: 18px 22px;
				font-family: "STIX Two Text", serif;
				font-style: italic;
				font-size: 19px;
				line-height: 2;
			}
			.answer-body :global(table.ltx_equation tbody),
			.answer-body :global(table.ltx_equation tr) {
				display: block;
			}
			.answer-body :global(table.ltx_equation td) {
				display: inline-block;
				padding: 0;
				white-space: nowrap;
			}
			.answer-body :global(math) {
				max-width: 100%;
			}
			.step-body :global(table.ltx_equation) {
				display: block;
				max-width: 100%;
				overflow-x: auto;
			}
			/* 各設問の最終結果 ―― 「答え」の視覚記号（design/README.md C 節） */
			.answer-body :global(table.diary-final-equation) {
				background: rgba(82, 224, 245, 0.07);
				border-left: 2px solid #52e0f5;
				font-size: 20px;
			}
			.answer-body :global(hr) {
				border: none;
				height: 1px;
				background: rgba(255, 255, 255, 0.08);
			}
			.answer-overlay {
				position: absolute;
				inset: 0;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				gap: 18px;
				background: rgba(5, 6, 10, 0.55);
				opacity: 1;
				pointer-events: auto;
				transition: opacity 0.5s;
			}
			.answer-panel.is-revealed .answer-overlay {
				opacity: 0;
				pointer-events: none;
			}
			.answer-overlay p {
				margin: 0;
				font-size: 14px;
				color: #aeb6c2;
			}
			.reveal-btn {
				padding: 15px 34px;
				background: #52e0f5;
				color: #06232a;
				font-weight: 700;
				font-size: 14px;
				border-radius: 2px;
				cursor: pointer;
				border: none;
				font-family: inherit;
				display: inline-block;
			}
			.reveal-btn:hover {
				background: #7ce8f8;
			}
			.js-required-notice {
				margin: 0;
				font-size: 12px;
				color: #768190;
			}

			/* 右カラム */
			.col-side {
				display: flex;
				flex-direction: column;
				gap: 22px;
				min-width: 0;
			}
			.answer-card {
				display: flex;
				flex-direction: column;
				gap: 14px;
				padding: 24px;
				border: 1px solid rgba(255, 255, 255, 0.1);
				background: #080a10;
			}
			.answer-card .card-label {
				font: 400 10px "IBM Plex Mono", monospace;
				color: #768190;
				letter-spacing: 0.18em;
			}
			.answer-card .card-value {
				display: block;
				max-width: 100%;
			}
			/* 未開示: プレースホルダのみ表示。答えの実体は開示前に DOM 上へ
			   出さない（answer-body 側は blur 済みだが、こちらは別カラムの
			   独立要素なので "revealed" ノード自体を display:none で隠す）。 */
			.answer-card .card-value.placeholder {
				font: italic 400 30px "STIX Two Text", serif;
				color: #2a3340;
			}
			.answer-card .card-value.revealed {
				display: none;
				font-size: 15px;
				font-weight: 500;
				color: #52e0f5;
				transition: color 0.5s;
			}
			.answer-card .card-value.revealed:hover {
				color: #7ce8f8;
			}
			/* 開示後（STEP3 の開示ボタンの JS と連動。#149 でチェックボックス
			   ハックから <body>.is-revealed クラスの JS トグルに変更） */
			body.is-revealed .col-side .answer-card .card-value.placeholder {
				display: none;
			}
			body.is-revealed .col-side .answer-card .card-value.revealed {
				display: block;
			}

			.pdf-links {
				display: flex;
				flex-direction: column;
				gap: 1px;
				background: rgba(255, 255, 255, 0.1);
				border: 1px solid rgba(255, 255, 255, 0.1);
			}
			.pdf-links a {
				display: flex;
				align-items: center;
				gap: 14px;
				padding: 18px 20px;
				background: #05060a;
				transition: background 0.2s;
			}
			.pdf-links a:hover {
				background: #0c0f16;
			}
			.pdf-links .pdf-badge {
				font: 400 10px "IBM Plex Mono", monospace;
				color: #52e0f5;
				letter-spacing: 0.14em;
			}
			.pdf-links .pdf-name {
				font-size: 14px;
				font-weight: 500;
			}
			.pdf-links .arrow {
				margin-left: auto;
				color: #768190;
			}

			.related {
				display: flex;
				flex-direction: column;
				gap: 12px;
				padding-top: 6px;
			}
			.related .card-label {
				font: 400 10px "IBM Plex Mono", monospace;
				color: #768190;
				letter-spacing: 0.18em;
			}
			.related a {
				font-size: 14px;
				line-height: 1.7;
				color: #c3ccd8;
				border-bottom: 1px solid rgba(255, 255, 255, 0.08);
				padding-bottom: 12px;
			}
			.related a:hover {
				color: #52e0f5;
			}
			.related .related-empty {
				font-size: 12px;
				color: #6d7a8f;
			}

			.report-link {
				font-size: 12px;
				color: #768190;
				border-bottom: 1px solid rgba(255, 255, 255, 0.12);
				padding-bottom: 6px;
				align-self: flex-start;
			}
			.report-link:hover {
				color: #aeb6c2;
			}

			/* フォールバック */
			.fallback-notice {
				padding: 18px 22px;
				border: 1px solid rgba(82, 224, 245, 0.28);
				background: rgba(82, 224, 245, 0.05);
				margin-bottom: 8px;
				font-size: 14px;
				line-height: 1.8;
				color: #aeb6c2;
			}
			.fallback-notice strong {
				color: #52e0f5;
				font-weight: 700;
			}
			.fallback-embed {
				width: 100%;
				height: 80vh;
				border: 1px solid rgba(255, 255, 255, 0.1);
				background: #fff;
			}

			@media (max-width: 900px) {
				.site-header {
					padding-left: 24px;
					padding-right: 24px;
				}
				.solution-grid {
					grid-template-columns: 1fr;
					gap: 40px;
					padding: 32px 24px;
				}
				.title-heading {
					font-size: 28px;
					word-break: break-word;
				}
				.answer-body :global(p),
				.step-body {
					word-break: break-word;
				}
			}
			@media (max-width: 480px) {
				.answer-body {
					padding: 22px 18px 26px;
					/* design/03_mobile.dc.html M解答: モバイルはブラー 8px（デスクトップは 9px） */
					filter: blur(8px);
				}
				.answer-body.is-revealed {
					filter: blur(0);
				}
				.step-panel .step-body {
					padding: 0 18px 20px;
				}
				.reveal-btn {
					padding: 13px 28px;
					font-size: 13px;
				}
				.fallback-embed {
					height: 60vh;
				}
			}
		</style>
	</head>
	<body>
		<header class="site-header">
			<a class="logo" href="/">
				<strong>Diary</strong>
				<span>SELF-MADE MATHEMATICS</span>
			</a>
			<div class="header-links">
				<a href="/archive/">アーカイブ</a>
				<a class="back-link" href={problemHref}>← 問題に戻る</a>
			</div>
		</header>

		<main class="solution-grid">
			<div class="col-main">
				<div class="head-block">
					<span class="eyebrow mono">SOLUTION / {meta.id}</span>
					<h1 class="title-heading">{displayTitle}</h1>
					<DifficultyBadge difficulty={meta.difficulty} linkToLegend />
					<p class="lede">まず自分で解いてから。必要な分だけ開いてください。</p>
				</div>

				{
					solutionHtml.isFallback ? (
						<div class="fallback-notice">
							<strong>この解答は HTML への自動変換に失敗したため、PDF を埋め込み表示しています。</strong>
							{solutionHtml.fallbackReason && <>（理由: {solutionHtml.fallbackReason}）</>}
						</div>
					) : null
				}

				{
					solutionHtml.isFallback ? (
						pdfAvailable ? (
							<embed class="fallback-embed" src={pdfHref} type="application/pdf" />
						) : (
							<p>PDF も見つかりませんでした。ビルドを確認してください。</p>
						)
					) : (
						<>
							{
								hintHtml && (
									<details class="step-panel">
										<summary>
											<span class="step-label mono">STEP 1</span>
											<span class="step-title">ヒント</span>
											<span class="step-toggle mono" />
										</summary>
										<div class="step-body-wrap">
											<div class="step-body-inner">
												<div class="step-body" set:html={hintHtml.bodyHtml} />
											</div>
										</div>
									</details>
								)
							}

							{
								policyHtml && (
									<details class="step-panel">
										<summary>
											<span class="step-label mono">STEP 2</span>
											<span class="step-title">方針</span>
											<span class="step-toggle mono" />
										</summary>
										<div class="step-body-wrap">
											<div class="step-body-inner">
												<div class="step-body" set:html={policyHtml.bodyHtml} />
											</div>
										</div>
									</details>
								)
							}

							<div class="answer-panel">
								<div class="step-head">
									<span class="step-label mono">STEP 3</span>
									<span class="step-title">解答</span>
									<span class="step-toggle mono" />
								</div>
								<div class="answer-reveal-wrap">
									{/* #149: 未開示状態では答え本文を平文で DOM に出さない。
									    hidden 属性の div は空のままにしておき、答え本文は
									    <script type="application/octet-stream"> に base64 化して
									    埋め込む（この type はブラウザに実行されず、内容は
									    アクセシビリティツリーにも露出しない）。開示ボタンが
									    押されたときだけ JS でデコードして .answer-body に挿入する。 */}
									<div class="answer-body" id={answerAnchorId} hidden />
									<script
										type="application/octet-stream"
										class="answer-body-data"
										set:text={bodyHtmlEncoded}
									/>
									<div class="answer-overlay">
										<p>解き終わりましたか？</p>
										<button
											type="button"
											class="reveal-btn js-answer-reveal-btn"
											aria-expanded="false"
											aria-controls={answerAnchorId}
										>
											解答を表示する
										</button>
										<noscript>
											<p class="js-required-notice">
												解答の表示には JavaScript が必要です。
											</p>
										</noscript>
									</div>
								</div>
							</div>
						</>
					)
				}
			</div>

			<div class="col-side">
				<div class="answer-card">
					<span class="card-label mono">ANSWER</span>
					{/* 未開示は常に ● ● ● のみ。開示後（STEP3 のチェックボックスと
					    連動）にだけ本文の答えブロックへのアンカーリンクへ切り替える。
					    未開示状態で答え（の断片）が一切 DOM 上に見える形で
					    露出しないようにする（#67 レビュー対応）。 */}
					<span class="card-value placeholder">● ● ●</span>
					<a class="card-value revealed" href={`#${answerAnchorId}`}>
						✓ 解答を見る
					</a>
				</div>

				<div class="pdf-links">
					{
						pdfAvailable && (
							<a href={pdfHref} download>
								<span class="pdf-badge mono">PDF</span>
								<span class="pdf-name">解答（印刷用）</span>
								<span class="arrow">↓</span>
							</a>
						)
					}
				</div>

				<div class="related">
					<span class="card-label mono">RELATED</span>
					{
						related.length > 0 ? (
							related.map((p) => (
								<a href={`/problems/${p.id}/`}>
									{p.id} — {formatMathTitle(p.title)}
								</a>
							))
						) : (
							<span class="related-empty">同分野の他の問題はまだありません</span>
						)
					}
				</div>

				<a class="report-link" href={issueHref} target="_blank" rel="noopener noreferrer">
					誤植・不備を報告する → GitHub Issue
				</a>
			</div>
		</main>

		{/* #149: STEP3 の開示ボタン用の最小限の JS。site/CLAUDE.md が許容する
		    「解答表示トグル」の JS であり、追加のライブラリ・状態保存は無い。
		    base64 化された答え本文のデコード・挿入、hidden 属性のトグル、
		    aria-expanded の同期、ANSWER カードの placeholder/revealed 切り替えのみを行う。
		    JS が無効な環境では答え本文は base64 のまま script 要素に留まり、
		    .answer-body には何も挿入されない ＝ 常に非表示のまま（要求どおり
		    「表示できない」側に倒れる）。
		    #152: 併せて、横スクロールする数式に tabindex を振る（下記参照）。 */}
		<script>
			// issue #152: 横スクロールする数式にキーボードフォーカスを通す。
			// 実際にスクロールが発生している要素にだけ tabindex を振る
			// （全数式に振るとタブ移動が過剰になるため）。
			import { markScrollableMath } from "../../../lib/scrollable-math";

			function decodeBase64Utf8(base64: string): string {
				const binary = atob(base64);
				const bytes = Uint8Array.from(binary, (c) => c.charCodeAt(0));
				return new TextDecoder().decode(bytes);
			}

			// ヒント・方針（STEP1/2）は <details> なので開いたときに測り直す。
			const applyStepScrollableMath = () => {
				markScrollableMath(document, ".step-body .ltx_Math, .step-body table.ltx_equation");
			};
			applyStepScrollableMath();
			window.addEventListener("resize", applyStepScrollableMath);
			for (const panel of document.querySelectorAll(".step-panel")) {
				panel.addEventListener("toggle", applyStepScrollableMath);
			}

			// 解答（answer-body）は未開示のあいだ DOM 上に何も挿入されない
			// （#149）ため、数式そのものが存在せずタブ順に入らない。開示ボタンの
			// クリックで innerHTML への注入が完了した「後」にだけ数式を計測して
			// tabindex を付与する。resize でも同様に、既に開示済みの場合のみ
			// 再計算する。
			const applyAnswerScrollableMath = () => {
				markScrollableMath(document, ".answer-body.is-revealed .ltx_Math, .answer-body.is-revealed table.ltx_equation");
			};
			window.addEventListener("resize", applyAnswerScrollableMath);

			document.querySelectorAll(".js-answer-reveal-btn").forEach((btn) => {
				btn.addEventListener("click", () => {
					const wrap = btn.closest(".answer-reveal-wrap");
					const panel = btn.closest(".answer-panel");
					const body = wrap?.querySelector(".answer-body");
					const dataEl = wrap?.querySelector(".answer-body-data");
					if (!(body instanceof HTMLElement)) return;

					if (!body.dataset.revealed && dataEl?.textContent) {
						body.innerHTML = decodeBase64Utf8(dataEl.textContent.trim());
						body.dataset.revealed = "true";
						// デコード後は不要になった data アイランドを DOM から除去する。
						dataEl.remove();
					}

					body.hidden = false;
					// hidden を外した直後に is-revealed を付けることで
					// blur(9px) → blur(0) の transition を発火させる。
					requestAnimationFrame(() => {
						body.classList.add("is-revealed");
						// is-revealed が付いてレイアウトが確定した後に測る
						// （hidden 解除直後だと幅がまだ 0 のことがあるため）。
						applyAnswerScrollableMath();
					});
					panel?.classList.add("is-revealed");
					btn.setAttribute("aria-expanded", "true");
					document.body.classList.add("is-revealed");
				});
			});
		</script>
	</body>
</html>
